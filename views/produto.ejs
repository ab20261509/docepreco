<%- include('partials/topo') %>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alerta alerta-sucesso">
    <span>✅</span>
    <span>Ficha técnica e precificação salvas com sucesso!</span>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alerta alerta-erro">
    <span>⚠️</span>
    <span><%= erro %></span>
  </div>
<% } %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--cor-texto);">
      <%= modo === 'novo' ? 'Nova Ficha Técnica e Precificação' : 'Ficha Técnica: ' + produto.nome %>
    </h1>
    <p style="color: var(--cor-texto-suave);">Partes 2 e 3 da planilha &bull; Calcule custos de ingredientes, embalagens, tempo e margem</p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/" class="btn btn-secundario">← Voltar ao Painel</a>
    <% if (modo === 'editar') { %>
      <form method="POST" action="/produtos/<%= produto.id %>/excluir" style="margin: 0;" onsubmit="return confirm('Deseja realmente excluir este produto?');">
        <button type="submit" class="btn btn-perigo">Excluir Produto</button>
      </form>
    <% } %>
  </div>
</div>

<form method="POST" action="<%= modo === 'novo' ? '/produtos' : '/produtos/' + produto.id %>" id="form-produto">
  <div class="layout-produto">
    <!-- Coluna da Esquerda: Formulários da Ficha Técnica -->
    <div>
      <!-- 1. Dados Básicos do Produto -->
      <div class="cartao">
        <div class="cartao-titulo">
          <span>🍰 1. Dados da Receita</span>
        </div>

        <div class="form-grupo">
          <label for="nome">Nome do Produto / Receita *</label>
          <input type="text" id="nome" name="nome" value="<%= produto.nome || '' %>" required placeholder="Ex: Brigadeiro Gourmet Tradicional, Bolo Red Velvet...">
        </div>

        <div class="form-linha">
          <div class="form-grupo">
            <label for="rendimento">Rendimento do Lote (unidades) *</label>
            <input type="number" id="rendimento" name="rendimento" value="<%= produto.rendimento %>" step="1" min="1" required class="recalc-trigger">
            <span class="ajuda-texto">Unidades produzidas nesta receita</span>
          </div>

          <div class="form-grupo">
            <label>Tempo de Produção *</label>
            <% 
              const tempoTotal = parseFloat(produto.tempo_horas) || 0;
              const horasIniciais = Math.floor(tempoTotal);
              const minutosIniciais = Math.round((tempoTotal - horasIniciais) * 60);
            %>
            <div class="controle-tempo-wrapper">
              <div class="tempo-bloco">
                <input type="number" id="tempo_horas_parte" name="tempo_horas_parte" min="0" max="999" step="1" value="<%= horasIniciais %>" placeholder="0" class="recalc-trigger input-tempo" title="Horas de produção">
                <span class="tempo-legenda">Horas</span>
              </div>
              <span class="tempo-separador">:</span>
              <div class="tempo-bloco">
                <input type="number" id="tempo_minutos_parte" name="tempo_minutos_parte" min="0" max="59" step="1" value="<%= minutosIniciais %>" placeholder="00" class="recalc-trigger input-tempo" title="Minutos de produção">
                <span class="tempo-legenda">Minutos</span>
              </div>
            </div>
            <input type="hidden" id="tempo_horas" name="tempo_horas" value="<%= produto.tempo_horas %>">
            <span class="ajuda-texto">Custo fixo: <%= formatMoney(cfHora) %>/h</span>
          </div>

          <div class="form-grupo">
            <label for="mao_obra_extra">Mão de Obra Extra (R$)</label>
            <input type="number" id="mao_obra_extra" name="mao_obra_extra" value="<%= produto.mao_obra_extra %>" step="0.01" min="0" class="recalc-trigger">
            <span class="ajuda-texto">Deixe 0 se já incluso nos fixos</span>
          </div>
        </div>
      </div>

      <!-- 2. Ingredientes (Item A) -->
      <div class="cartao">
        <div class="cartao-titulo" style="margin-bottom: 0.35rem;">
          <span>🥣 2. Ingredientes (Item A)</span>
          <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
            <a href="/produtos/modelo-excel" class="btn btn-secundario btn-sm" title="Baixar planilha de exemplo Excel">
              📥 Modelo
            </a>
            <button type="button" class="btn btn-secundario btn-sm" id="btn-importar-excel" title="Importar ingredientes a partir de arquivo Excel">
              📊 Importar Excel
            </button>
            <button type="button" class="btn btn-secundario btn-sm" id="btn-add-ingrediente">
              ➕ Adicionar Linha
            </button>
          </div>
        </div>
        <input type="file" id="input-arquivo-excel" accept=".xlsx, .xls, .csv" style="display: none;">
        <div style="font-size: 0.78rem; color: var(--cor-texto-suave); margin-bottom: 0.75rem;">
          💡 Pesquise no catálogo para vincular o insumo. Os campos com 🔒 são preenchidos automaticamente.
        </div>

        <div class="tabela-container">
          <table id="tabela-ingredientes">
            <thead>
              <tr>
                <th style="width: 35%;">Ingrediente (Catálogo)</th>
                <th style="width: 16%;">Qtd Usada</th>
                <th style="width: 15%;">Preço Pacote 🔒</th>
                <th style="width: 15%;">Qtd Pacote 🔒</th>
                <th style="width: 14%; text-align: right;">Custo Receita</th>
                <th style="width: 36px; text-align: center;"></th>
              </tr>
            </thead>
            <tbody id="corpo-ingredientes">
              <% if (ingredientes && ingredientes.length > 0) { %>
                <% ingredientes.forEach((ing) => { %>
                  <tr class="linha-ingrediente">
                    <td>
                      <div class="busca-ingrediente-wrapper">
                        <input type="text" name="ing_nome" class="ing-nome-input" value="<%= ing.nome %>" placeholder="🔍 Digite para pesquisar..." required autocomplete="off">
                        <div class="dropdown-sugestoes-ingrediente" style="display: none;"></div>
                      </div>
                    </td>
                    <td><input type="number" name="ing_qtd_usada" class="ing-qtd-usada recalc-trigger" value="<%= ing.qtd_usada %>" step="any" min="0" placeholder="Ex: 395" required></td>
                    <td><input type="number" name="ing_preco_pacote" class="ing-preco-pacote recalc-trigger campo-bloqueado" value="<%= ing.preco_pacote %>" step="0.01" min="0" placeholder="Catálogo" readonly title="Valor obtido do catálogo" required></td>
                    <td><input type="number" name="ing_qtd_pacote" class="ing-qtd-pacote recalc-trigger campo-bloqueado" value="<%= ing.qtd_pacote %>" step="any" min="0.001" placeholder="Catálogo" readonly title="Tamanho do pacote obtido do catálogo" required></td>
                    <td style="text-align: right; font-weight: 700; font-size: 0.88rem;" class="ing-custo-calculado">R$ 0,00</td>
                    <td style="text-align: center;"><button type="button" class="btn-icone-tabela" onclick="removerLinha(this)" title="Remover item">✕</button></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <!-- Linha inicial modelo para novos produtos -->
                <tr class="linha-ingrediente">
                  <td>
                    <div class="busca-ingrediente-wrapper">
                      <input type="text" name="ing_nome" class="ing-nome-input" placeholder="🔍 Digite para pesquisar..." required autocomplete="off">
                      <div class="dropdown-sugestoes-ingrediente" style="display: none;"></div>
                    </div>
                  </td>
                  <td><input type="number" name="ing_qtd_usada" class="ing-qtd-usada recalc-trigger" step="any" min="0" placeholder="Ex: 395" required></td>
                  <td><input type="number" name="ing_preco_pacote" class="ing-preco-pacote recalc-trigger campo-bloqueado" step="0.01" min="0" placeholder="Catálogo" readonly title="Valor obtido do catálogo" required></td>
                  <td><input type="number" name="ing_qtd_pacote" class="ing-qtd-pacote recalc-trigger campo-bloqueado" step="any" min="0.001" placeholder="Catálogo" readonly title="Tamanho obtido do catálogo" required></td>
                  <td style="text-align: right; font-weight: 700; font-size: 0.88rem;" class="ing-custo-calculado">R$ 0,00</td>
                  <td style="text-align: center;"><button type="button" class="btn-icone-tabela" onclick="removerLinha(this)" title="Remover item">✕</button></td>
                </tr>
              <% } %>
            </tbody>
            <tfoot>
              <tr style="background-color: #faf5f3; font-weight: 700;">
                <td colspan="4" style="text-align: right; font-size: 0.85rem;">Total de Ingredientes (A):</td>
                <td style="text-align: right; color: var(--cor-primaria); font-size: 0.95rem;" id="display-total-a">R$ 0,00</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- 3. Embalagens e Complementos (Item B) -->
      <div class="cartao">
        <div class="cartao-titulo">
          <span>🎁 3. Embalagens e Complementos (Item B)</span>
          <button type="button" class="btn btn-secundario btn-sm" id="btn-add-complemento">➕ Adicionar Embalagem</button>
        </div>

        <div class="tabela-container">
          <table id="tabela-complementos">
            <thead>
              <tr>
                <th style="width: 68%;">Item (Caixas, Forminhas, Fitas, Sacolas, Tags...)</th>
                <th style="width: 25%; text-align: right;">Custo no Lote (R$)</th>
                <th style="width: 36px; text-align: center;"></th>
              </tr>
            </thead>
            <tbody id="corpo-complementos">
              <% if (complementos && complementos.length > 0) { %>
                <% complementos.forEach((comp) => { %>
                  <tr class="linha-complemento">
                    <td><input type="text" name="comp_nome" value="<%= comp.nome %>" placeholder="Ex: Forminhas 4 pétalas (30 un)" required></td>
                    <td><input type="number" name="comp_custo" class="comp-custo recalc-trigger" value="<%= comp.custo_lote %>" step="0.01" min="0" placeholder="0.00" style="text-align: right;" required></td>
                    <td style="text-align: center;"><button type="button" class="btn-icone-tabela" onclick="removerLinha(this)" title="Remover item">✕</button></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr class="linha-complemento">
                  <td><input type="text" name="comp_nome" placeholder="Ex: Forminhas e embalagem do lote"></td>
                  <td><input type="number" name="comp_custo" class="comp-custo recalc-trigger" step="0.01" min="0" placeholder="0.00" style="text-align: right;"></td>
                  <td style="text-align: center;"><button type="button" class="btn-icone-tabela" onclick="removerLinha(this)" title="Remover item">✕</button></td>
                </tr>
              <% } %>
            </tbody>
            <tfoot>
              <tr style="background-color: #faf5f3; font-weight: 700;">
                <td style="text-align: right; font-size: 0.85rem;">Total de Embalagens / Complementos (B):</td>
                <td style="text-align: right; color: var(--cor-primaria); font-size: 0.95rem;" id="display-total-b">R$ 0,00</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- 4. Margem de Lucro e Taxas -->
      <div class="cartao">
        <div class="cartao-titulo">
          <span>📈 4. Margem Desejada e Taxas</span>
        </div>

        <div class="form-linha">
          <div class="form-grupo">
            <label for="margem_pct">Margem de Lucro Desejada (%) *</label>
            <input type="number" id="margem_pct" name="margem_pct" value="<%= produto.margem_pct %>" step="0.5" min="0" max="99" required class="recalc-trigger">
            <span class="ajuda-texto">Recomendado na confeitaria: 30% a 50%</span>
          </div>

          <div class="form-grupo">
            <label for="taxas_pct">Taxas de Venda / Cartão (%) *</label>
            <input type="number" id="taxas_pct" name="taxas_pct" value="<%= produto.taxas_pct %>" step="0.1" min="0" max="99" required class="recalc-trigger">
            <span class="ajuda-texto">Taxa média de maquininha, iFood ou impostos</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna da Direita: Card Flutuante de Resultado ao Vivo -->
    <div>
      <div class="painel-resultado-sticky">
        <h3 style="font-size: 1.15rem; color: var(--cor-texto); text-align: center;">💡 Precificação Automática</h3>

        <div class="destaque-preco">
          <div class="valor" id="display-preco-unitario">R$ 0,00</div>
          <div class="legenda">Preço Sugerido por Unidade</div>
        </div>

        <div class="lista-metricas">
          <div class="metrica-linha">
            <span>Custo por Unidade:</span>
            <strong id="display-custo-unitario">R$ 0,00</strong>
          </div>

          <div class="metrica-linha destaque">
            <span>Lucro por Unidade:</span>
            <strong id="display-lucro-unitario">R$ 0,00</strong>
          </div>

          <div class="metrica-linha">
            <span>% Lucro s/ Preço:</span>
            <strong id="display-perc-lucro">0,0%</strong>
          </div>

          <div class="metrica-linha" style="border-top: 1px dashed var(--cor-borda); padding-top: 0.5rem; margin-top: 0.25rem;">
            <span>Lucro Total do Lote:</span>
            <strong id="display-lucro-lote" style="color: var(--cor-verde);">R$ 0,00</strong>
          </div>

          <div class="metrica-linha">
            <span>Custo Total do Lote:</span>
            <strong id="display-custo-lote">R$ 0,00</strong>
          </div>
        </div>

        <!-- Composição de Custos -->
        <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--cor-borda); font-size: 0.8rem; color: var(--cor-texto-suave);">
          <div style="font-weight: 700; margin-bottom: 0.4rem; text-transform: uppercase;">Composição do Lote:</div>
          <div class="metrica-linha"><span>A - Ingredientes:</span> <span id="comp-a">R$ 0,00</span></div>
          <div class="metrica-linha"><span>B - Embalagens:</span> <span id="comp-b">R$ 0,00</span></div>
          <div class="metrica-linha"><span>C - Custo Fixo (<span id="comp-tempo">0h</span> &times; <%= formatMoney(cfHora) %>):</span> <span id="comp-c">R$ 0,00</span></div>
          <div class="metrica-linha"><span>D - Mão de Obra Extra:</span> <span id="comp-d">R$ 0,00</span></div>
        </div>

        <div id="alerta-fator-invalido" style="display: none; margin-top: 1rem; color: var(--cor-alerta); font-size: 0.85rem; font-weight: 600;">
          ⚠️ Margem + taxas somam 100% ou mais! O preço não pode ser calculado.
        </div>

        <button type="submit" class="btn btn-primario btn-block" style="margin-top: 1.5rem; font-size: 1.05rem; padding: 0.85rem;">
          💾 Salvar Ficha Técnica
        </button>
      </div>
    </div>
  </div>
</form>

<script>
  const CUSTO_FIXO_HORA = <%= cfHora || 0 %>;

  function formatarMoeda(num) {
    if (isNaN(num)) num = 0;
    return num.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  function recalcularTudo() {
    // 1. Calcular Ingredientes (A)
    const linhasIng = document.querySelectorAll('.linha-ingrediente');
    let totalA = 0;
    linhasIng.forEach(linha => {
      const qtdUsada = parseFloat(linha.querySelector('.ing-qtd-usada').value) || 0;
      const precoPacote = parseFloat(linha.querySelector('.ing-preco-pacote').value) || 0;
      const qtdPacote = parseFloat(linha.querySelector('.ing-qtd-pacote').value) || 0;

      let custoItem = 0;
      if (qtdPacote > 0) {
        custoItem = (qtdUsada / qtdPacote) * precoPacote;
      }
      totalA += custoItem;
      const cellCusto = linha.querySelector('.ing-custo-calculado');
      if (cellCusto) cellCusto.textContent = formatarMoeda(custoItem);
    });

    document.getElementById('display-total-a').textContent = formatarMoeda(totalA);
    document.getElementById('comp-a').textContent = formatarMoeda(totalA);

    // 2. Calcular Complementos (B)
    const linhasComp = document.querySelectorAll('.linha-complemento');
    let totalB = 0;
    linhasComp.forEach(linha => {
      const custo = parseFloat(linha.querySelector('.comp-custo').value) || 0;
      totalB += custo;
    });

    document.getElementById('display-total-b').textContent = formatarMoeda(totalB);
    document.getElementById('comp-b').textContent = formatarMoeda(totalB);

    // 3. Custo Fixo Alocado (C)
    const elHorasParte = document.getElementById('tempo_horas_parte');
    const elMinutosParte = document.getElementById('tempo_minutos_parte');
    const hParte = elHorasParte ? Math.max(0, parseInt(elHorasParte.value, 10) || 0) : 0;
    const mParte = elMinutosParte ? Math.max(0, parseInt(elMinutosParte.value, 10) || 0) : 0;
    const tempoHoras = hParte + (mParte / 60);

    const inputHiddenTempo = document.getElementById('tempo_horas');
    if (inputHiddenTempo) inputHiddenTempo.value = tempoHoras > 0 ? tempoHoras.toFixed(4) : '0';

    const totalC = tempoHoras * CUSTO_FIXO_HORA;
    let labelTempo = '0h';
    if (hParte > 0 && mParte > 0) labelTempo = `${hParte}h ${mParte}min`;
    else if (hParte > 0) labelTempo = `${hParte}h`;
    else if (mParte > 0) labelTempo = `${mParte}min`;

    document.getElementById('comp-tempo').textContent = labelTempo;
    document.getElementById('comp-c').textContent = formatarMoeda(totalC);

    // 4. Mão de Obra Extra (D)
    const totalD = parseFloat(document.getElementById('mao_obra_extra').value) || 0;
    document.getElementById('comp-d').textContent = formatarMoeda(totalD);

    // Totais do Lote
    const custoLote = totalA + totalB + totalC + totalD;
    document.getElementById('display-custo-lote').textContent = formatarMoeda(custoLote);

    const rendimento = parseFloat(document.getElementById('rendimento').value) || 1;
    const custoUnit = rendimento > 0 ? (custoLote / rendimento) : custoLote;
    document.getElementById('display-custo-unitario').textContent = formatarMoeda(custoUnit);

    // Fator de Preço
    const margemPct = parseFloat(document.getElementById('margem_pct').value) || 0;
    const taxasPct = parseFloat(document.getElementById('taxas_pct').value) || 0;
    const fator = 1 - (margemPct + taxasPct) / 100;

    const alertaInvalido = document.getElementById('alerta-fator-invalido');

    if (fator <= 0) {
      alertaInvalido.style.display = 'block';
      document.getElementById('display-preco-unitario').textContent = '---';
      document.getElementById('display-lucro-unitario').textContent = '---';
      document.getElementById('display-perc-lucro').textContent = '---';
      document.getElementById('display-lucro-lote').textContent = '---';
      return;
    } else {
      alertaInvalido.style.display = 'none';
    }

    const preco = custoUnit / fator;
    const lucroUnit = preco - custoUnit;
    const lucroLote = lucroUnit * rendimento;
    const percLucro = preco > 0 ? (lucroUnit / preco) * 100 : 0;

    document.getElementById('display-preco-unitario').textContent = formatarMoeda(preco);
    document.getElementById('display-lucro-unitario').textContent = formatarMoeda(lucroUnit);
    document.getElementById('display-perc-lucro').textContent = percLucro.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
    document.getElementById('display-lucro-lote').textContent = formatarMoeda(lucroLote);
  }

  // Vincular eventos de recalculo
  // Vincular eventos de recalculo
  document.getElementById('form-produto').addEventListener('input', (e) => {
    if (e.target.classList.contains('recalc-trigger') || e.target.classList.contains('ing-qtd-usada') || e.target.classList.contains('ing-preco-pacote') || e.target.classList.contains('ing-qtd-pacote') || e.target.classList.contains('comp-custo')) {
      recalcularTudo();
    }
  });

  // Catálogo de Insumos para Autocomplete e Busca Interativa
  const catalogoItens = <%- JSON.stringify(catalogoIngredientes || []) %>;
  const catalogoMap = {};
  catalogoItens.forEach(cat => {
    catalogoMap[cat.nome.toLowerCase().trim()] = cat;
  });

  function destacarTermo(texto, termo) {
    if (!termo) return texto;
    const regex = new RegExp(`(${termo.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return texto.replace(regex, '<span style="color: var(--cor-primaria); font-weight: 800;">$1</span>');
  }

  function selecionarItemCatalogo(inputNome, item) {
    inputNome.value = item.nome;
    const tr = inputNome.closest('tr');
    const inputPreco = tr.querySelector('.ing-preco-pacote');
    const inputPacote = tr.querySelector('.ing-qtd-pacote');
    const inputUsada = tr.querySelector('.ing-qtd-usada');

    if (item.preco_atual > 0) inputPreco.value = item.preco_atual.toFixed(2);
    if (item.qtd_embalagem_padrao > 0) inputPacote.value = item.qtd_embalagem_padrao;

    atualizarBadgeEstoque(inputNome, item);
    fecharTodosDropdowns();
    recalcularTudo();

    if (inputUsada) {
      inputUsada.focus();
      inputUsada.select();
    }
  }

  function atualizarBadgeEstoque(inputNome, item) {
    let badge = inputNome.parentNode.querySelector('.badge-estoque-info');
    if (!badge) {
      badge = document.createElement('div');
      badge.className = 'badge-estoque-info';
      badge.style.fontSize = '0.75rem';
      badge.style.marginTop = '0.25rem';
      inputNome.parentNode.appendChild(badge);
    }
    const corEstoque = item.estoque_atual > 0 ? 'var(--cor-verde)' : 'var(--cor-alerta)';
    const statusTxt = item.estoque_atual > 0 ? '✓ Insumo do Estoque' : '⚠️ Estoque Zerado';
    badge.innerHTML = `<span style="color: ${corEstoque}; font-weight: 700;">${statusTxt}</span> &bull; Saldo: <strong>${item.estoque_atual} ${item.unidade}</strong> &bull; <button type="button" class="btn-lancar-compra-prod" style="background: none; border: none; color: var(--cor-primaria); font-weight: 700; cursor: pointer; text-decoration: underline; font-size: 0.75rem; padding: 0;">🛒 Lançar Compra</button>`;

    const btnLancar = badge.querySelector('.btn-lancar-compra-prod');
    if (btnLancar) {
      btnLancar.addEventListener('click', (e) => {
        e.preventDefault();
        abrirModalCompraParaIngrediente(item.id, inputNome);
      });
    }
  }

  function fecharTodosDropdowns() {
    document.querySelectorAll('.dropdown-sugestoes-ingrediente').forEach(d => {
      d.style.display = 'none';
      d.innerHTML = '';
    });
  }

  function inicializarBuscaInput(inputNome) {
    const wrapper = inputNome.closest('.busca-ingrediente-wrapper');
    if (!wrapper) return;
    const dropdown = wrapper.querySelector('.dropdown-sugestoes-ingrediente');
    if (!dropdown) return;

    let itemIndexAtivo = -1;

    function renderizarSugestoes(termo) {
      const q = (termo || '').toLowerCase().trim();
      let filtrados = [];
      if (!q) {
        filtrados = catalogoItens.slice(0, 10);
      } else {
        filtrados = catalogoItens.filter(cat => cat.nome.toLowerCase().includes(q));
      }

      dropdown.innerHTML = '';
      itemIndexAtivo = -1;

      if (filtrados.length === 0) {
        if (catalogoItens.length === 0) {
          dropdown.innerHTML = '<div style="padding: 0.75rem 0.85rem; font-size: 0.85rem; color: #666;">Nenhum ingrediente cadastrado no catálogo.<br><a href="/ingredientes" target="_blank" style="color: var(--cor-primaria); font-weight: 700; text-decoration: underline; margin-top: 4px; display: inline-block;">➕ Cadastrar no Catálogo de Ingredientes</a></div>';
        } else {
          dropdown.innerHTML = `<div style="padding: 0.75rem 0.85rem; font-size: 0.85rem; color: #666;">Nenhum insumo encontrado para "<strong>${termo}</strong>".<br><a href="/ingredientes" target="_blank" style="color: var(--cor-primaria); font-weight: 700; text-decoration: underline; margin-top: 4px; display: inline-block;">➕ Cadastrar "${termo}" no Catálogo</a></div>`;
        }
        dropdown.style.display = 'block';
        return;
      }

      filtrados.forEach((item, idx) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'item-sugestao-ingrediente';
        itemDiv.dataset.idx = idx;

        const corEstoqueBg = item.estoque_atual > 0 ? '#e8f5e9' : '#ffebee';
        const corEstoqueTxt = item.estoque_atual > 0 ? '#2e7d32' : '#c62828';

        itemDiv.innerHTML = `
          <div>
            <div class="item-sugestao-nome">${destacarTermo(item.nome, q)}</div>
            <div class="item-sugestao-detalhe">
              R$ ${item.preco_atual.toFixed(2).replace('.', ',')} / pct de ${item.qtd_embalagem_padrao}${item.unidade}
            </div>
          </div>
          <div>
            <span class="item-sugestao-estoque" style="background-color: ${corEstoqueBg}; color: ${corEstoqueTxt};">
              Estoque: ${item.estoque_atual} ${item.unidade}
            </span>
          </div>
        `;

        itemDiv.addEventListener('mousedown', (e) => {
          e.preventDefault();
          selecionarItemCatalogo(inputNome, item);
        });

        dropdown.appendChild(itemDiv);
      });

      dropdown.style.display = 'block';
    }

    inputNome.addEventListener('input', () => {
      renderizarSugestoes(inputNome.value);
      const exato = catalogoMap[inputNome.value.toLowerCase().trim()];
      if (exato) {
        atualizarBadgeEstoque(inputNome, exato);
      } else {
        const badge = wrapper.querySelector('.badge-estoque-info');
        if (badge) badge.remove();
      }
    });

    inputNome.addEventListener('focus', () => {
      renderizarSugestoes(inputNome.value);
    });

    inputNome.addEventListener('keydown', (e) => {
      const itens = dropdown.querySelectorAll('.item-sugestao-ingrediente');
      if (dropdown.style.display !== 'block' || itens.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        itemIndexAtivo = (itemIndexAtivo + 1) % itens.length;
        itens.forEach((el, i) => el.classList.toggle('item-ativo', i === itemIndexAtivo));
        if (itens[itemIndexAtivo]) itens[itemIndexAtivo].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        itemIndexAtivo = (itemIndexAtivo - 1 + itens.length) % itens.length;
        itens.forEach((el, i) => el.classList.toggle('item-ativo', i === itemIndexAtivo));
        if (itens[itemIndexAtivo]) itens[itemIndexAtivo].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        if (itemIndexAtivo >= 0 && itemIndexAtivo < itens.length) {
          e.preventDefault();
          itens[itemIndexAtivo].dispatchEvent(new MouseEvent('mousedown'));
        }
      } else if (e.key === 'Escape') {
        dropdown.style.display = 'none';
      }
    });

    inputNome.addEventListener('blur', () => {
      setTimeout(() => {
        dropdown.style.display = 'none';
      }, 250);
    });

    if (inputNome.value) {
      const match = catalogoMap[inputNome.value.toLowerCase().trim()];
      if (match) {
        atualizarBadgeEstoque(inputNome, match);
      }
    }
  }

  // Inicializar busca em todos os inputs de ingredientes presentes
  document.querySelectorAll('.ing-nome-input').forEach(inicializarBuscaInput);

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.busca-ingrediente-wrapper')) {
      fecharTodosDropdowns();
    }
  });

  // Adicionar ingrediente dinamicamente
  document.getElementById('btn-add-ingrediente').addEventListener('click', () => {
    const tbody = document.getElementById('corpo-ingredientes');
    const tr = document.createElement('tr');
    tr.className = 'linha-ingrediente';
    tr.innerHTML = `
      <td>
        <div class="busca-ingrediente-wrapper">
          <input type="text" name="ing_nome" class="ing-nome-input" placeholder="🔍 Digite para pesquisar..." required autocomplete="off">
          <div class="dropdown-sugestoes-ingrediente" style="display: none;"></div>
        </div>
      </td>
      <td><input type="number" name="ing_qtd_usada" class="ing-qtd-usada recalc-trigger" step="any" min="0" placeholder="Ex: 50" required></td>
      <td><input type="number" name="ing_preco_pacote" class="ing-preco-pacote recalc-trigger campo-bloqueado" step="0.01" min="0" placeholder="Catálogo" readonly title="Valor obtido do catálogo" required></td>
      <td><input type="number" name="ing_qtd_pacote" class="ing-qtd-pacote recalc-trigger campo-bloqueado" step="any" min="0.001" placeholder="Catálogo" readonly title="Tamanho obtido do catálogo" required></td>
      <td style="text-align: right; font-weight: 700; font-size: 0.88rem;" class="ing-custo-calculado">R$ 0,00</td>
      <td style="text-align: center;"><button type="button" class="btn-icone-tabela" onclick="removerLinha(this)" title="Remover item">✕</button></td>
    `;
    tbody.appendChild(tr);
    const novoInput = tr.querySelector('.ing-nome-input');
    inicializarBuscaInput(novoInput);
    novoInput.focus();
    recalcularTudo();
  });

  // Adicionar complemento dinamicamente
  document.getElementById('btn-add-complemento').addEventListener('click', () => {
    const tbody = document.getElementById('corpo-complementos');
    const tr = document.createElement('tr');
    tr.className = 'linha-complemento';
    tr.innerHTML = `
      <td><input type="text" name="comp_nome" placeholder="Ex: Fita de cetim e tag personalizada" required></td>
      <td><input type="number" name="comp_custo" class="comp-custo recalc-trigger" step="0.01" min="0" placeholder="0.00" style="text-align: right;" required></td>
      <td style="text-align: center;"><button type="button" class="btn-icone-tabela" onclick="removerLinha(this)" title="Remover item">✕</button></td>
    `;
    tbody.appendChild(tr);
    recalcularTudo();
  });

  function removerLinha(btn) {
    const tr = btn.closest('tr');
    tr.remove();
    recalcularTudo();
  }

  // Importação a partir de planilha Excel (.xlsx, .xls, .csv)
  const btnImportarExcel = document.getElementById('btn-importar-excel');
  const inputArquivoExcel = document.getElementById('input-arquivo-excel');

  if (btnImportarExcel && inputArquivoExcel) {
    btnImportarExcel.addEventListener('click', () => {
      inputArquivoExcel.click();
    });

    inputArquivoExcel.addEventListener('change', (event) => {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheetName = workbook.SheetNames[0];
          if (!firstSheetName) {
            alert('A planilha selecionada está vazia.');
            return;
          }

          const worksheet = workbook.Sheets[firstSheetName];
          const rows = XLSX.utils.sheet_to_json(worksheet, { defval: '' });

          if (!rows || rows.length === 0) {
            alert('Nenhum dado encontrado na primeira aba da planilha.');
            return;
          }

          function normalizarTexto(txt) {
            return String(txt || '')
              .toLowerCase()
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '')
              .trim();
          }

          function parseValorNumerico(val) {
            if (typeof val === 'number') return val;
            if (!val) return 0;
            let str = String(val).trim().replace(/[R$\s]/gi, '');
            if (str.includes(',')) {
              str = str.replace(/\./g, '').replace(',', '.');
            }
            const n = parseFloat(str);
            return isNaN(n) ? 0 : n;
          }

          // Identificar as colunas dinamicamente
          const primeiroItem = rows[0];
          const chaves = Object.keys(primeiroItem);

          let chaveIngrediente = null;
          let chaveQtdUsada = null;
          let chavePrecoPacote = null;
          let chaveQtdPacote = null;

          chaves.forEach(k => {
            const norm = normalizarTexto(k);
            if (norm.includes('ingrediente') || norm.includes('item') || norm.includes('nome')) {
              chaveIngrediente = k;
            } else if (norm.includes('usada') || norm.includes('usado') || (norm.includes('g/ml/un') && !norm.includes('pacote'))) {
              chaveQtdUsada = k;
            } else if (norm.includes('preco') || norm.includes('valor') || norm.includes('custo')) {
              chavePrecoPacote = k;
            } else if (norm.includes('pacote') || norm.includes('embalagem')) {
              chaveQtdPacote = k;
            }
          });

          // Fallbacks por posição caso os nomes não coincidam
          if (!chaveIngrediente && chaves[0]) chaveIngrediente = chaves[0];
          if (!chaveQtdUsada && chaves[1]) chaveQtdUsada = chaves[1];
          if (!chavePrecoPacote && chaves[2]) chavePrecoPacote = chaves[2];
          if (!chaveQtdPacote && chaves[3]) chaveQtdPacote = chaves[3];

          const ingredientesValidos = [];
          rows.forEach(r => {
            const nome = String(r[chaveIngrediente] || '').trim();
            const qtdUsada = parseValorNumerico(r[chaveQtdUsada]);
            const precoPacote = parseValorNumerico(r[chavePrecoPacote]);
            const qtdPacote = parseValorNumerico(r[chaveQtdPacote]);

            if (nome && qtdPacote > 0) {
              ingredientesValidos.push({
                nome,
                qtdUsada,
                precoPacote,
                qtdPacote
              });
            }
          });

          if (ingredientesValidos.length === 0) {
            alert('Não foi possível reconhecer os ingredientes. Certifique-se de que a planilha possui as colunas:\n\n- Ingrediente\n- Qtd Usada (g/ml/un)\n- Preço Pacote (R$)\n- Qtd Pacote (g/ml/un)\n\nDica: Você pode clicar em "Baixar Modelo Excel" para usar nossa planilha pronta!');
            return;
          }

          const tbody = document.getElementById('corpo-ingredientes');
          const linhasAtuais = tbody.querySelectorAll('.linha-ingrediente');

          const apenasLinhaVazia = linhasAtuais.length === 1 && !linhasAtuais[0].querySelector('input[name="ing_nome"]').value.trim();

          let limparTabela = apenasLinhaVazia;
          if (!apenasLinhaVazia && linhasAtuais.length > 0) {
            limparTabela = confirm('Deseja SUBSTITUIR os ingredientes existentes pelos da planilha importada?\n\n- Clique em [OK] para Substituir todos.\n- Clique em [Cancelar] para Adicionar os novos aos que já estão na tela.');
          }

          if (limparTabela) {
            tbody.innerHTML = '';
          }

          ingredientesValidos.forEach(item => {
            const tr = document.createElement('tr');
            tr.className = 'linha-ingrediente';
            tr.innerHTML = `
              <td>
                <div class="busca-ingrediente-wrapper">
                  <input type="text" name="ing_nome" class="ing-nome-input" value="${item.nome.replace(/"/g, '&quot;')}" placeholder="🔍 Digite para pesquisar..." required autocomplete="off">
                  <div class="dropdown-sugestoes-ingrediente" style="display: none;"></div>
                </div>
              </td>
              <td><input type="number" name="ing_qtd_usada" class="ing-qtd-usada recalc-trigger" value="${item.qtdUsada}" step="any" min="0" placeholder="Ex: 395 (g/ml/un)" required></td>
              <td><input type="number" name="ing_preco_pacote" class="ing-preco-pacote recalc-trigger campo-bloqueado" value="${item.precoPacote.toFixed(2)}" step="0.01" min="0" placeholder="0.00" readonly title="Valor obtido do catálogo ou planilha" required></td>
              <td><input type="number" name="ing_qtd_pacote" class="ing-qtd-pacote recalc-trigger campo-bloqueado" value="${item.qtdPacote}" step="any" min="0.001" placeholder="Embalagem" readonly title="Tamanho obtido do catálogo ou planilha" required></td>
              <td style="text-align: right; font-weight: 600;" class="ing-custo-calculado">R$ 0,00</td>
              <td style="text-align: center;"><button type="button" class="btn btn-perigo btn-sm" onclick="removerLinha(this)">✕</button></td>
            `;
            tbody.appendChild(tr);
            inicializarBuscaInput(tr.querySelector('.ing-nome-input'));
          });

          recalcularTudo();
          alert('✅ ' + ingredientesValidos.length + ' ingrediente(s) importado(s) com sucesso da planilha!');
        } catch (err) {
          console.error('Erro ao ler Excel:', err);
          alert('Erro ao processar o arquivo Excel: ' + err.message);
        } finally {
          inputArquivoExcel.value = '';
        }
      };

      reader.readAsArrayBuffer(file);
    });
  }

  // Executar recálculo inicial ao carregar a página
  window.addEventListener('DOMContentLoaded', recalcularTudo);

  // Modal de Lançar Compra dentro do Produto
  const modalCompraProd = document.getElementById('modal-lancar-compra-produto');
  const formCompraProd = document.getElementById('prod-form-lancar-compra');
  const btnFecharCompraProdX = document.getElementById('prod-btn-fechar-compra-x');
  const btnCancelarCompraProd = document.getElementById('prod-btn-cancelar-compra');
  const prodCompraNomeIng = document.getElementById('prod-compra-nome-ing');
  const prodCompraId = document.getElementById('prod-modal-compra-id');
  const prodCompraQtd = document.getElementById('prod_compra_qtd');
  const prodCompraQtdPor = document.getElementById('prod_compra_qtd_por');
  const prodCompraPreco = document.getElementById('prod_compra_preco');
  const prodCompraData = document.getElementById('prod_compra_data');
  const prodCompraValidade = document.getElementById('prod_compra_validade');
  const prodCompraVolumeResumo = document.getElementById('prod-compra-volume-resumo');
  const prodCompraTotalResumo = document.getElementById('prod-compra-total-resumo');
  let prodUnidadeAtualModal = 'g';
  let inputOrigemCompra = null;

  function recalcularPreviaCompraProdModal() {
    const qtd = parseFloat(prodCompraQtd.value) || 0;
    const qtdPor = parseFloat(prodCompraQtdPor.value) || 0;
    const preco = parseFloat(prodCompraPreco.value) || 0;

    const volume = qtd * qtdPor;
    const total = qtd * preco;

    prodCompraVolumeResumo.textContent = '+ ' + volume.toLocaleString('pt-BR') + ' ' + prodUnidadeAtualModal;
    prodCompraTotalResumo.textContent = formatarMoeda(total);
  }

  document.querySelectorAll('.prod-compra-calc').forEach(inp => {
    inp.addEventListener('input', recalcularPreviaCompraProdModal);
  });

  function abrirModalCompraParaIngrediente(itemId, inputElement) {
    const item = catalogoItens.find(c => c.id == itemId) || Object.values(catalogoMap).find(c => c.id == itemId);
    if (!item) return;

    inputOrigemCompra = inputElement;
    prodCompraId.value = item.id;
    prodCompraNomeIng.textContent = item.nome || '';
    prodUnidadeAtualModal = item.unidade || 'g';
    document.querySelectorAll('.prod-compra-unidade-txt').forEach(el => el.textContent = prodUnidadeAtualModal);

    prodCompraQtd.value = 1;
    prodCompraQtdPor.value = item.qtd_embalagem_padrao || '';
    prodCompraPreco.value = item.preco_atual !== undefined && item.preco_atual > 0 ? item.preco_atual : '';
    prodCompraData.value = new Date().toISOString().split('T')[0];
    prodCompraValidade.value = '';

    recalcularPreviaCompraProdModal();

    modalCompraProd.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
      prodCompraQtd.focus();
      prodCompraQtd.select();
    }, 50);
  }

  if (btnFecharCompraProdX) btnFecharCompraProdX.addEventListener('click', () => {
    modalCompraProd.style.display = 'none';
    document.body.style.overflow = '';
  });

  if (btnCancelarCompraProd) btnCancelarCompraProd.addEventListener('click', () => {
    modalCompraProd.style.display = 'none';
    document.body.style.overflow = '';
  });

  modalCompraProd.addEventListener('click', (e) => {
    if (e.target === modalCompraProd) {
      modalCompraProd.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  // Submissão da compra via AJAX na tela de Produto
  formCompraProd.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = prodCompraId.value;
    if (!id) return;

    const btnSubmit = document.getElementById('prod-btn-submit-compra');
    btnSubmit.disabled = true;
    btnSubmit.textContent = 'Gravando...';

    const params = new URLSearchParams();
    params.append('ajax', '1');
    params.append('data_compra', prodCompraData.value);
    params.append('data_validade', prodCompraValidade.value);
    params.append('qtd_embalagens', prodCompraQtd.value);
    params.append('qtd_por_embalagem', prodCompraQtdPor.value);
    params.append('valor_unitario_embalagem', prodCompraPreco.value);

    try {
      const resp = await fetch(`/ingredientes/${id}/compras`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: params.toString()
      });

      const resJson = await resp.json();
      if (resJson.sucesso && resJson.ingrediente) {
        const atualizado = resJson.ingrediente;
        const idx = catalogoItens.findIndex(c => c.id == id);
        if (idx !== -1) catalogoItens[idx] = atualizado;
        catalogoMap[atualizado.nome.toLowerCase().trim()] = atualizado;

        if (inputOrigemCompra) {
          selecionarItemCatalogo(inputOrigemCompra, atualizado);
        } else {
          document.querySelectorAll('.ing-nome-input').forEach(inp => {
            if (inp.value.toLowerCase().trim() === atualizado.nome.toLowerCase().trim()) {
              selecionarItemCatalogo(inp, atualizado);
            }
          });
        }

        modalCompraProd.style.display = 'none';
        document.body.style.overflow = '';
      } else {
        alert('Erro ao registrar compra.');
      }
    } catch (err) {
      console.error('Erro na requisição:', err);
      alert('Erro ao registrar compra: ' + err.message);
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.textContent = '➕ Registrar Entrada no Estoque';
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalCompraProd && modalCompraProd.style.display === 'flex') {
      modalCompraProd.style.display = 'none';
      document.body.style.overflow = '';
    }
  });
</script>

<!-- Modal Popup: Lançar Compra para Ingrediente dentro da Tela de Produto -->
<div id="modal-lancar-compra-produto" class="modal-overlay" style="display: none;">
  <div class="modal-container">
    <div class="modal-header">
      <h3 style="margin: 0; color: var(--cor-texto); font-size: 1.25rem; font-weight: 700;">
        🛒 Lançar Compra: <span id="prod-compra-nome-ing" style="color: var(--cor-primaria);"></span>
      </h3>
      <button type="button" class="btn-fechar-modal" id="prod-btn-fechar-compra-x" aria-label="Fechar">&times;</button>
    </div>

    <form id="prod-form-lancar-compra">
      <input type="hidden" id="prod-modal-compra-id" value="">
      <div class="modal-body">
        <p class="ajuda-texto" style="margin-bottom: 1rem;">
          Registre a compra para <strong>alimentar o saldo em estoque</strong> e <strong>atualizar o preço do pacote</strong> nesta receita automaticamente.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
          <div class="form-grupo">
            <label for="prod_compra_data">Data da Compra *</label>
            <input type="date" id="prod_compra_data" name="data_compra" value="<%= new Date().toISOString().split('T')[0] %>" required>
          </div>

          <div class="form-grupo">
            <label for="prod_compra_validade">Data de Validade</label>
            <input type="date" id="prod_compra_validade" name="data_validade">
            <span class="ajuda-texto">Vencimento do lote</span>
          </div>

          <div class="form-grupo">
            <label for="prod_compra_qtd">Qtd Comprada (Pacotes/Un) *</label>
            <input type="number" id="prod_compra_qtd" name="qtd_embalagens" step="any" min="0.001" value="1" required class="prod-compra-calc">
            <span class="ajuda-texto">Ex: 5 caixas ou unidades</span>
          </div>

          <div class="form-grupo">
            <label for="prod_compra_qtd_por">Tamanho Pacote (<span class="prod-compra-unidade-txt">g</span>) *</label>
            <input type="number" id="prod_compra_qtd_por" name="qtd_por_embalagem" step="any" min="0.001" required class="prod-compra-calc">
            <span class="ajuda-texto">Conteúdo por pacote</span>
          </div>

          <div class="form-grupo" style="grid-column: 1 / -1;">
            <label for="prod_compra_preco">Preço Unitário do Pacote (R$) *</label>
            <input type="number" id="prod_compra_preco" name="valor_unitario_embalagem" step="0.01" min="0" required placeholder="Ex: 6.50" class="prod-compra-calc">
            <span class="ajuda-texto">Preço pago por pacote/lata</span>
          </div>
        </div>

        <!-- Resumo visual em tempo real -->
        <div style="background-color: var(--cor-fundo); border: 1px solid var(--cor-borda); border-radius: 8px; padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div>
            <div style="font-size: 0.8rem; color: var(--cor-texto-suave);">Volume no Estoque:</div>
            <strong id="prod-compra-volume-resumo" style="font-size: 1.05rem; color: var(--cor-verde);">+ 0</strong>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--cor-texto-suave);">Total da Compra:</div>
            <strong id="prod-compra-total-resumo" style="font-size: 1.15rem; color: var(--cor-primaria);">R$ 0,00</strong>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secundario" id="prod-btn-cancelar-compra">Cancelar</button>
