<%- include('partials/topo') %>

<div class="auth-wrapper">
  <div class="auth-header">
    <div class="logo-icone">🧁</div>
    <h1>Bem-vinda de volta!</h1>
    <p style="color: var(--cor-texto-suave);">Acesse sua conta para gerenciar seus preços e receitas</p>
  </div>

  <div class="cartao">
    <% if (erro) { %>
      <div class="alerta alerta-erro">
        <span>⚠️</span>
        <span><%= erro %></span>
      </div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-grupo">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= email || '' %>" required autocomplete="email" placeholder="seu@email.com">
      </div>

      <div class="form-grupo">
        <label for="senha">Senha</label>
        <input type="password" id="senha" name="senha" required autocomplete="current-password" placeholder="Digite sua senha">
      </div>

      <button type="submit" class="btn btn-primario btn-block" style="margin-top: 0.85rem; padding: 0.55rem; font-size: 0.9rem;">Entrar no Sistema</button>
    </form>
  </div>

  <div class="auth-footer">
    <p>Ainda não tem uma conta? <a href="/cadastro">Cadastre-se gratuitamente</a></p>
  </div>
</div>

<%- include('partials/rodape') %>
