<%- include('partials/topo') %>

<!-- KPIs Comerciais Modernizados com Ícones e Destaque -->
<div class="grid-kpis">
  <div class="kpi-card kpi-azul">
    <div class="kpi-card-conteudo">
      <span class="kpi-rotulo">Total de Pedidos</span>
      <span class="kpi-valor"><%= kpis.total %></span>
      <span class="kpi-subtexto">Registrados no sistema</span>
    </div>
    <div class="kpi-icone-wrapper">📝</div>
  </div>

  <div class="kpi-card kpi-laranja">
    <div class="kpi-card-conteudo">
      <span class="kpi-rotulo">Em Aberto / Produção</span>
      <span class="kpi-valor" style="color: #c2410c;"><%= kpis.abertos %></span>
      <span class="kpi-subtexto">Orçamentos e pedidos ativos</span>
    </div>
    <div class="kpi-icone-wrapper">⏳</div>
  </div>

  <div class="kpi-card kpi-verde">
    <div class="kpi-card-conteudo">
      <span class="kpi-rotulo">Entregues com Sucesso</span>
      <span class="kpi-valor" style="color: #15803d;"><%= kpis.entregues %></span>
      <span class="kpi-subtexto">Encomendas finalizadas</span>
    </div>
    <div class="kpi-icone-wrapper">🟢</div>
  </div>

  <div class="kpi-card kpi-rosa">
    <div class="kpi-card-conteudo">
      <span class="kpi-rotulo">Faturamento Previsto</span>
      <span class="kpi-valor" style="color: var(--cor-primaria);"><%= formatMoney(kpis.faturamento) %></span>
      <span class="kpi-subtexto">Volume total negociado</span>
    </div>
    <div class="kpi-icone-wrapper">💰</div>
  </div>
</div>

<div class="cartao">
  <div class="cartao-cabecalho" style="flex-wrap: wrap; gap: 0.8rem; align-items: center;">
    <div>
      <h2>📝 Pedidos & Orçamentos</h2>
      <p class="subtitulo" style="margin-bottom: 0;">Acompanhe encomendas da fábrica, datas de entrega e pagamentos</p>
    </div>
    
    <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
      <!-- Alternador Cards vs Tabela -->
      <div class="toggle-visualizacao">
        <button type="button" class="btn-modo-vis ativo" id="btnVisCards" title="Visualizar em Cards">
          <span>☷</span> <span>Cards</span>
        </button>
        <button type="button" class="btn-modo-vis" id="btnVisTabela" title="Visualizar em Tabela">
          <span>☰</span> <span>Tabela</span>
        </button>
      </div>

      <div style="position: relative;">
        <input 
          type="text" 
          id="buscaPedidos" 
          placeholder="🔍 Buscar cliente ou pedido..." 
          class="input-busca-tabela"
          style="width: 210px;"
        >
      </div>
      <a href="/pedidos/novo" class="btn btn-primario btn-sm" style="white-space: nowrap;">
        ➕ Novo Pedido / Orçamento
      </a>
    </div>
  </div>

  <!-- Barra de Filtros: Status e Período de Entrega -->
  <div style="display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 1.15rem;">
    <!-- Linha 1: Status -->
    <div class="filtro-abas" style="margin-bottom: 0;">
      <a href="/pedidos?status=todos<%= periodoFiltro !== 'todos' ? '&periodo=' + periodoFiltro : '' %><%= dataDe ? '&data_de=' + dataDe : '' %><%= dataAte ? '&data_ate=' + dataAte : '' %>" class="aba-item <%= statusFiltro === 'todos' ? 'ativa' : '' %>">
        <span>Todos</span>
        <span class="badge-aba"><%= kpis.total %></span>
      </a>
      <a href="/pedidos?status=orcamento<%= periodoFiltro !== 'todos' ? '&periodo=' + periodoFiltro : '' %><%= dataDe ? '&data_de=' + dataDe : '' %><%= dataAte ? '&data_ate=' + dataAte : '' %>" class="aba-item <%= statusFiltro === 'orcamento' ? 'ativa' : '' %>">
        <span>📋 Orçamentos</span>
      </a>
      <a href="/pedidos?status=confirmado<%= periodoFiltro !== 'todos' ? '&periodo=' + periodoFiltro : '' %><%= dataDe ? '&data_de=' + dataDe : '' %><%= dataAte ? '&data_ate=' + dataAte : '' %>" class="aba-item <%= statusFiltro === 'confirmado' ? 'ativa' : '' %>">
        <span>🟡 Confirmados</span>
      </a>
      <a href="/pedidos?status=producao<%= periodoFiltro !== 'todos' ? '&periodo=' + periodoFiltro : '' %><%= dataDe ? '&data_de=' + dataDe : '' %><%= dataAte ? '&data_ate=' + dataAte : '' %>" class="aba-item <%= statusFiltro === 'producao' ? 'ativa' : '' %>">
        <span>🟠 Em Produção</span>
      </a>
      <a href="/pedidos?status=entregue<%= periodoFiltro !== 'todos' ? '&periodo=' + periodoFiltro : '' %><%= dataDe ? '&data_de=' + dataDe : '' %><%= dataAte ? '&data_ate=' + dataAte : '' %>" class="aba-item <%= statusFiltro === 'entregue' ? 'ativa' : '' %>">
        <span>🟢 Entregues</span>
      </a>
      <a href="/pedidos?status=cancelado<%= periodoFiltro !== 'todos' ? '&periodo=' + periodoFiltro : '' %><%= dataDe ? '&data_de=' + dataDe : '' %><%= dataAte ? '&data_ate=' + dataAte : '' %>" class="aba-item <%= statusFiltro === 'cancelado' ? 'ativa' : '' %>">
        <span>🔴 Cancelados</span>
      </a>
    </div>

    <!-- Linha 2: Período de Entrega -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.65rem; background: #faf7f8; border: 1px solid #ebd9c3; border-radius: 10px; padding: 0.5rem 0.85rem;">
      <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
        <span style="font-size: 0.76rem; font-weight: 700; color: var(--cor-texto-suave); text-transform: uppercase; margin-right: 0.2rem;">
          📅 Entrega:
        </span>
        <a href="/pedidos?status=<%= statusFiltro %>&periodo=todos" class="btn-periodo-pill <%= periodoFiltro === 'todos' && !dataDe && !dataAte ? 'ativo' : '' %>">
          Todos os Períodos
        </a>
        <a href="/pedidos?status=<%= statusFiltro %>&periodo=hoje" class="btn-periodo-pill <%= periodoFiltro === 'hoje' ? 'ativo' : '' %>">
          Hoje
        </a>
        <a href="/pedidos?status=<%= statusFiltro %>&periodo=amanha" class="btn-periodo-pill <%= periodoFiltro === 'amanha' ? 'ativo' : '' %>">
          Amanhã
        </a>
        <a href="/pedidos?status=<%= statusFiltro %>&periodo=semana" class="btn-periodo-pill <%= periodoFiltro === 'semana' ? 'ativo' : '' %>">
          Próximos 7 Dias
        </a>
        <a href="/pedidos?status=<%= statusFiltro %>&periodo=mes" class="btn-periodo-pill <%= periodoFiltro === 'mes' ? 'ativo' : '' %>">
          Este Mês
        </a>
      </div>

      <!-- Formulário Período Personalizado (De / Até) -->
      <form method="GET" action="/pedidos" style="margin: 0; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
        <input type="hidden" name="status" value="<%= statusFiltro %>">
        <input type="hidden" name="periodo" value="personalizado">
        <span style="font-size: 0.76rem; color: var(--cor-texto-suave); font-weight: 600;">De:</span>
        <input type="date" name="data_de" value="<%= dataDe %>" class="input" style="height: 30px; font-size: 0.78rem; width: 125px; padding: 0.15rem 0.35rem;">
        <span style="font-size: 0.76rem; color: var(--cor-texto-suave); font-weight: 600;">Até:</span>
        <input type="date" name="data_ate" value="<%= dataAte %>" class="input" style="height: 30px; font-size: 0.78rem; width: 125px; padding: 0.15rem 0.35rem;">
        <button type="submit" class="btn btn-primario btn-sm" style="height: 30px; padding: 0 0.65rem; font-size: 0.78rem;">
          Filtrar
        </button>
        <% if (periodoFiltro !== 'todos' || dataDe || dataAte || statusFiltro !== 'todos') { %>
          <a href="/pedidos" class="btn btn-secundario btn-sm" style="height: 30px; padding: 0 0.55rem; font-size: 0.78rem; color: #dc2626; border-color: #fca5a5;" title="Limpar todos os filtros">
            ✕ Limpar
          </a>
        <% } %>
      </form>
    </div>
  </div>

  <% if (pedidos.length === 0) { %>
    <div style="text-align: center; padding: 2.5rem 1rem; color: var(--cor-texto-suave);">
      <span style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">📝</span>
      <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.4rem;">Nenhum pedido encontrado</p>
      <p style="font-size: 0.85rem; margin-bottom: 1rem;">Crie orçamentos rápidos para clientes selecionando produtos da fábrica.</p>
      <a href="/pedidos/novo" class="btn btn-primario btn-sm">➕ Criar Primeiro Pedido</a>
    </div>
  <% } else { %>

    <!-- 1. MODO CARDS DE PEDIDOS (NOVO DESIGN MODERNO) -->
    <div class="grid-pedidos-cards" id="containerCardsPedidos">
      <% pedidos.forEach(p => { %>
        <div class="card-pedido-item item-filtrado" data-busca="<%= p.id %> <%= p.nomeCliente.toLowerCase() %> <%= p.telefoneFormatado %> <%= p.dataEntregaFmt %> <%= p.status %> <%= (p.resumo_itens || '').toLowerCase() %>">
          <div>
            <!-- Topo do Card -->
            <div class="card-pedido-topo">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <a href="/pedidos/<%= p.id %>" class="card-pedido-id">#<%= p.id %></a>
                <span class="badge-tipo-logistica <%= p.tipo_entrega === 'entrega' ? 'badge-logistica-entrega' : 'badge-logistica-retirada' %>">
                  <%= p.tipo_entrega === 'entrega' ? '🚗 Entrega' : '🏬 Retirada' %>
                </span>
              </div>

              <% if (p.status === 'orcamento') { %>
                <span class="badge-pedido-status status-orcamento">📋 Orçamento</span>
              <% } else if (p.status === 'confirmado') { %>
                <span class="badge-pedido-status status-confirmado">🟡 Confirmado</span>
              <% } else if (p.status === 'producao') { %>
                <span class="badge-pedido-status status-producao">🟠 Em Produção</span>
              <% } else if (p.status === 'entregue') { %>
                <span class="badge-pedido-status status-entregue">🟢 Entregue</span>
              <% } else { %>
                <span class="badge-pedido-status status-cancelado">🔴 Cancelado</span>
              <% } %>
            </div>

            <!-- Dados do Cliente & Entrega -->
            <div class="card-pedido-cliente">
              <div class="card-pedido-nome-cliente"><%= p.nomeCliente %></div>
              <div class="card-pedido-entrega">
                <span style="font-weight: 700; color: var(--cor-texto);">📅 <%= p.dataEntregaFmt %></span>
                <% if (p.horario_entrega) { %>
                  <span>⏰ <%= p.horario_entrega %></span>
                <% } %>
                <% if (p.cliente_cadastrado_bairro) { %>
                  <span>• 📍 <%= p.cliente_cadastrado_bairro %></span>
                <% } %>
              </div>
            </div>

            <!-- Itens do Pedido Preview -->
            <div class="card-pedido-itens-box">
              <div class="card-pedido-itens-titulo">🎂 Itens do Pedido (<%= p.total_itens %>)</div>
              <div class="card-pedido-itens-texto">
                <%= p.resumo_itens || (p.total_itens + ' itens cadastrados') %>
              </div>
            </div>
          </div>

          <!-- Rodapé Financeiro e Ações -->
          <div>
            <div class="card-pedido-financeiro">
              <div>
                <div class="card-pedido-valor-total"><%= formatMoney(p.valor_total) %></div>
                <div class="card-pedido-pag-status">
                  <% if (p.status_pagamento === 'pago') { %>
                    <span style="color: #15803d; font-weight: 700;">✓ Pago Integral</span>
                  <% } else if (p.valor_sinal > 0) { %>
                    <span style="color: #0369a1; font-weight: 600;">Sinal <%= formatMoney(p.valor_sinal) %></span>
                    <span style="color: #c2410c; font-weight: 700;">• Saldo <%= formatMoney(p.saldoRestante) %></span>
                  <% } else { %>
                    <span style="color: #b45309; font-weight: 600;">Pagamento Pendente</span>
                  <% } %>
                </div>
              </div>

              <div class="card-pedido-acoes">
                <% if (p.waLink) { %>
                  <a href="<%= p.waLink %>" target="_blank" rel="noopener noreferrer" class="btn-icone-tabela" style="border-color: #86efac; background: #f0fdf4; color: #16a34a;" title="Abrir WhatsApp">
                    💬
                  </a>
                <% } %>
                <a href="/pedidos/<%= p.id %>" class="btn-icone-tabela" style="border-color: #bae6fd; background: #f0f9ff; color: #0369a1;" title="Ver Detalhes">
                  👁️
                </a>
                <a href="/pedidos/<%= p.id %>/editar" class="btn-icone-tabela" style="border-color: #fed7aa; background: #fff7ed; color: #c2410c;" title="Editar">
                  ✏️
                </a>
                <form method="POST" action="/pedidos/<%= p.id %>/excluir" style="margin: 0;" onsubmit="return confirm('Deseja realmente excluir o pedido #<%= p.id %>?');">
                  <button type="submit" class="btn-icone-tabela" title="Excluir">
                    🗑️
                  </button>
                </form>
              </div>
            </div>
          </div>

        </div>
      <% }); %>
    </div>

    <!-- 2. MODO TABELA COMPACTA (ALTERNATIVO) -->
    <div class="tabela-responsiva" id="containerTabelaPedidos" style="display: none;">
      <table class="tabela" id="tabelaPedidos">
        <thead>
          <tr>
            <th style="width: 65px;">#</th>
            <th style="width: 130px;">Data Entrega</th>
            <th>Cliente</th>
            <th style="width: 140px;">Recebimento</th>
            <th style="width: 70px; text-align: center;">Itens</th>
            <th style="width: 110px; text-align: right;">Total</th>
            <th style="width: 150px;">Pagamento</th>
            <th style="width: 120px; text-align: center;">Status</th>
            <th style="width: 120px; text-align: center;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% pedidos.forEach(p => { %>
            <tr class="linha-pedido item-filtrado" data-busca="<%= p.id %> <%= p.nomeCliente.toLowerCase() %> <%= p.telefoneFormatado %> <%= p.dataEntregaFmt %> <%= p.status %> <%= (p.resumo_itens || '').toLowerCase() %>">
              <td>
                <a href="/pedidos/<%= p.id %>" style="font-weight: 800; color: var(--cor-primaria); text-decoration: none;">
                  #<%= p.id %>
                </a>
              </td>
              <td>
                <div style="font-weight: 700; color: var(--cor-texto); font-size: 0.88rem;">
                  📅 <%= p.dataEntregaFmt %>
                </div>
                <% if (p.horario_entrega) { %>
                  <div style="font-size: 0.76rem; color: var(--cor-texto-suave);">
                    ⏰ <%= p.horario_entrega %>
                  </div>
                <% } %>
              </td>
              <td>
                <div style="font-weight: 700; color: var(--cor-texto);">
                  <%= p.nomeCliente %>
                </div>
                <% if (p.telefoneFormatado) { %>
                  <div style="font-size: 0.78rem; margin-top: 2px;">
                    <% if (p.waLink) { %>
                      <a href="<%= p.waLink %>" target="_blank" rel="noopener noreferrer" style="color: #25d366; text-decoration: none; font-weight: 600;">
                        💬 <%= p.telefoneFormatado %>
                      </a>
                    <% } else { %>
                      <span style="color: var(--cor-texto-suave);"><%= p.telefoneFormatado %></span>
                    <% } %>
                  </div>
                <% } %>
              </td>
              <td>
                <% if (p.tipo_entrega === 'entrega') { %>
                  <span style="font-size: 0.82rem; font-weight: 600; color: #0284c7;">
                    🚗 Entrega
                  </span>
                  <% if (p.cliente_cadastrado_bairro) { %>
                    <div style="font-size: 0.74rem; color: var(--cor-texto-suave); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 130px;">
                      <%= p.cliente_cadastrado_bairro %>
                    </div>
                  <% } %>
                <% } else { %>
                  <span style="font-size: 0.82rem; font-weight: 600; color: #4b5563;">
                    🏬 Retirada
                  </span>
                <% } %>
              </td>
              <td style="text-align: center;">
                <span class="badge-contador" style="font-size: 0.78rem;">
                  <%= p.total_itens %> <%= p.total_itens === 1 ? 'item' : 'itens' %>
                </span>
              </td>
              <td style="text-align: right; font-weight: 800; color: var(--cor-texto); font-size: 0.95rem;">
                <%= formatMoney(p.valor_total) %>
              </td>
              <td>
                <% if (p.status_pagamento === 'pago') { %>
                  <span style="font-size: 0.76rem; font-weight: 700; color: #15803d; background: #dcfce7; padding: 0.15rem 0.45rem; border-radius: 6px;">
                    ✓ Pago 100%
                  </span>
                <% } else if (p.valor_sinal > 0) { %>
                  <div style="font-size: 0.78rem; font-weight: 600; color: #0369a1;">
                    Sinal: <%= formatMoney(p.valor_sinal) %>
                  </div>
                  <div style="font-size: 0.74rem; color: #c2410c; font-weight: 700;">
                    Saldo: <%= formatMoney(p.saldoRestante) %>
                  </div>
                <% } else { %>
                  <span style="font-size: 0.76rem; font-weight: 600; color: #b45309; background: #fef3c7; padding: 0.15rem 0.45rem; border-radius: 6px;">
                    Pendente
                  </span>
                <% } %>
              </td>
              <td style="text-align: center;">
                <% if (p.status === 'orcamento') { %>
                  <span class="badge-pedido-status status-orcamento">📋 Orçamento</span>
                <% } else if (p.status === 'confirmado') { %>
                  <span class="badge-pedido-status status-confirmado">🟡 Confirmado</span>
                <% } else if (p.status === 'producao') { %>
                  <span class="badge-pedido-status status-producao">🟠 Em Produção</span>
                <% } else if (p.status === 'entregue') { %>
                  <span class="badge-pedido-status status-entregue">🟢 Entregue</span>
                <% } else { %>
                  <span class="badge-pedido-status status-cancelado">🔴 Cancelado</span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; gap: 0.25rem; justify-content: center;">
                  <% if (p.waLink) { %>
                    <a href="<%= p.waLink %>" target="_blank" rel="noopener noreferrer" class="btn-icone-tabela" style="border-color: #86efac; background: #f0fdf4; color: #16a34a;" title="Abrir WhatsApp">
                      💬
                    </a>
                  <% } %>
                  <a href="/pedidos/<%= p.id %>" class="btn-icone-tabela" style="border-color: #bae6fd; background: #f0f9ff; color: #0369a1;" title="Ver Detalhes">
                    👁️
                  </a>
                  <a href="/pedidos/<%= p.id %>/editar" class="btn-icone-tabela" style="border-color: #fed7aa; background: #fff7ed; color: #c2410c;" title="Editar">
                    ✏️
                  </a>
                  <form method="POST" action="/pedidos/<%= p.id %>/excluir" style="margin: 0;" onsubmit="return confirm('Deseja realmente excluir o pedido #<%= p.id %>?');">
                    <button type="submit" class="btn-icone-tabela" title="Excluir">
                      🗑️
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
  // Controle de Modo de Visualização (Cards vs Tabela)
  const btnCards = document.getElementById('btnVisCards');
  const btnTabela = document.getElementById('btnVisTabela');
  const containerCards = document.getElementById('containerCardsPedidos');
  const containerTabela = document.getElementById('containerTabelaPedidos');

  function aplicarModo(modo) {
    if (!containerCards || !containerTabela) return;
    if (modo === 'tabela') {
      containerCards.style.display = 'none';
      containerTabela.style.display = 'block';
      btnTabela.classList.add('ativo');
      btnCards.classList.remove('ativo');
    } else {
      containerCards.style.display = 'grid';
      containerTabela.style.display = 'none';
      btnCards.classList.add('ativo');
      btnTabela.classList.remove('ativo');
    }
    localStorage.setItem('modo_vis_pedidos', modo);
  }

  if (btnCards && btnTabela) {
    btnCards.addEventListener('click', () => aplicarModo('cards'));
    btnTabela.addEventListener('click', () => aplicarModo('tabela'));

    // Restaurar preferência anterior ou padrão (cards)
    const modoSalvo = localStorage.getItem('modo_vis_pedidos') || 'cards';
    aplicarModo(modoSalvo);
  }

  // Busca instantânea em tempo real filtrando tanto os Cards quanto as Linhas da Tabela
  const inputBusca = document.getElementById('buscaPedidos');
  if (inputBusca) {
    inputBusca.addEventListener('input', function() {
      const termo = this.value.toLowerCase().trim();
      const itens = document.querySelectorAll('.item-filtrado');
      itens.forEach(item => {
        const dados = item.getAttribute('data-busca') || '';
        item.style.display = dados.includes(termo) ? '' : 'none';
      });
    });
  }
</script>

<%- include('partials/rodape') %>
