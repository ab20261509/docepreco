<%- include('partials/topo') %>

<div style="max-width: 540px; margin: 3rem auto; text-align: center; padding: 2.5rem 1.5rem; background: #ffffff; border-radius: 16px; border: 1px solid var(--cor-borda); box-shadow: var(--sombra);">
  <div style="font-size: 3.5rem; margin-bottom: 1rem;">🚫</div>
  <h1 style="font-size: 1.5rem; font-weight: 800; color: #991b1b; margin-bottom: 0.5rem;">Acesso Não Autorizado</h1>
  <p style="color: var(--cor-texto-suave); font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.75rem;">
    <%= typeof mensagem !== 'undefined' ? mensagem : 'Você não possui permissão para acessar esta área ou executar esta ação.' %>
  </p>

  <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
    <a href="/" class="btn btn-primario">🏠 Voltar ao Início</a>
    <a href="javascript:history.back()" class="btn btn-secundario">↩️ Voltar à página anterior</a>
  </div>
</div>

<%- include('partials/rodape') %>
