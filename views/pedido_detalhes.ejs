<%- include('partials/topo') %>

<div style="max-width: 1100px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.15rem; flex-wrap: wrap; gap: 0.8rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <h2 style="margin: 0;">
        <%= pedido.status === 'orcamento' ? '📋 Orçamento' : '🎂 Pedido' %> #<%= pedido.id %>
      </h2>
      <% if (pedido.status === 'orcamento') { %>
        <span class="badge-pedido-status status-orcamento">📋 Orçamento</span>
      <% } else if (pedido.status === 'confirmado') { %>
        <span class="badge-pedido-status status-confirmado">🟡 Confirmado</span>
      <% } else if (pedido.status === 'producao') { %>
        <span class="badge-pedido-status status-producao">🟠 Em Produção</span>
      <% } else if (pedido.status === 'entregue') { %>
        <span class="badge-pedido-status status-entregue">🟢 Entregue</span>
      <% } else { %>
        <span class="badge-pedido-status status-cancelado">🔴 Cancelado</span>
      <% } %>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <button type="button" class="btn btn-secundario btn-sm" onclick="window.print();" title="Imprimir este pedido">
        🖨️ Imprimir
      </button>
      <a href="/pedidos/<%= pedido.id %>/editar" class="btn btn-secundario btn-sm" title="Editar dados e itens">
        ✏️ Editar
      </a>
      <a href="/pedidos" class="btn btn-secundario btn-sm">
        ← Todos os Pedidos
      </a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.25rem;">
    
    <!-- Coluna Esquerda: Dados do Pedido -->
    <div style="display: flex; flex-direction: column; gap: 1.15rem;">
      
      <!-- Cliente & Logística -->
      <div class="cartao">
        <h3 style="font-size: 1rem; margin-bottom: 0.75rem; color: var(--cor-primaria); display: flex; align-items: center; gap: 0.4rem;">
          <span>👤</span> <span>Cliente & Entrega</span>
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.88rem;">
          <div>
            <span style="color: var(--cor-texto-suave); font-size: 0.78rem; display: block;">Cliente</span>
            <strong style="font-size: 0.95rem; color: var(--cor-texto);"><%= pedido.nomeCliente %></strong>
            <% if (pedido.telefoneFormatado) { %>
              <div style="margin-top: 3px;">
                <% if (pedido.cliente_cadastrado_telefone || pedido.cliente_telefone_avulso) { %>
                  <a href="<%= waLink || '#' %>" target="_blank" rel="noopener noreferrer" style="color: #25d366; text-decoration: none; font-weight: 600; font-size: 0.82rem;">
                    💬 <%= pedido.telefoneFormatado %>
                  </a>
                <% } else { %>
                  <span style="color: var(--cor-texto-suave);"><%= pedido.telefoneFormatado %></span>
                <% } %>
              </div>
            <% } %>
          </div>

          <div>
            <span style="color: var(--cor-texto-suave); font-size: 0.78rem; display: block;">Data e Horário</span>
            <strong style="color: var(--cor-texto); font-size: 0.95rem;">📅 <%= pedido.dataEntregaFmt %></strong>
            <% if (pedido.horario_entrega) { %>
              <div style="color: var(--cor-texto-suave); font-size: 0.82rem;">
                ⏰ <%= pedido.horario_entrega %>
              </div>
            <% } %>
          </div>
        </div>

        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid #f1f1f1; font-size: 0.85rem;">
          <span style="color: var(--cor-texto-suave); font-size: 0.78rem; display: block;">Forma de Recebimento</span>
          <% if (pedido.tipo_entrega === 'entrega') { %>
            <div style="color: #0284c7; font-weight: 700; margin-top: 2px;">
              🚗 Entrega no Endereço
            </div>
            <% if (pedido.endereco_entrega) { %>
              <div style="color: var(--cor-texto); margin-top: 3px; font-size: 0.85rem;">
                📍 <%= pedido.endereco_entrega %>
              </div>
            <% } %>
          <% } else { %>
            <div style="color: #4b5563; font-weight: 700; margin-top: 2px;">
              🏬 Retirada no Local pelo Cliente
            </div>
          <% } %>
        </div>
      </div>

      <!-- Itens do Pedido -->
      <div class="cartao">
        <h3 style="font-size: 1rem; margin-bottom: 0.75rem; color: var(--cor-primaria); display: flex; align-items: center; gap: 0.4rem;">
          <span>🎂</span> <span>Itens Solicitados</span>
        </h3>

        <div class="tabela-responsiva">
          <table class="tabela">
            <thead>
              <tr>
                <th>Item</th>
                <th style="width: 60px; text-align: center;">Qtd</th>
                <th style="width: 90px; text-align: right;">Preço</th>
                <th style="width: 90px; text-align: right;">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% itens.forEach(item => { %>
                <tr>
                  <td>
                    <div style="font-weight: 700; color: var(--cor-texto);">
                      <%= item.descricao %>
                    </div>
                    <% if (item.observacao) { %>
                      <div style="font-size: 0.76rem; color: var(--cor-texto-suave); font-style: italic;">
                        Obs: <%= item.observacao %>
                      </div>
                    <% } %>
                  </td>
                  <td style="text-align: center; font-weight: 600;">
                    <%= item.quantidade %>
                  </td>
                  <td style="text-align: right; color: var(--cor-texto-suave); font-size: 0.85rem;">
                    <%= formatMoney(item.preco_unitario) %>
                  </td>
                  <td style="text-align: right; font-weight: 700; color: var(--cor-texto);">
                    <%= formatMoney(item.subtotal) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Fechamento Financeiro -->
      <div class="card-totais-pedido">
        <h3 style="font-size: 1rem; margin-bottom: 0.75rem; color: #7c2d12; display: flex; align-items: center; gap: 0.4rem;">
          <span>💰</span> <span>Resumo Financeiro</span>
        </h3>

        <div class="linha-total-pedido">
          <span>Subtotal dos Produtos</span>
          <strong><%= formatMoney(pedido.valor_produtos) %></strong>
        </div>

        <% if (pedido.taxa_entrega > 0) { %>
          <div class="linha-total-pedido">
            <span>Taxa de Entrega (+)</span>
            <strong>+<%= formatMoney(pedido.taxa_entrega) %></strong>
          </div>
        <% } %>

        <% if (pedido.desconto > 0) { %>
          <div class="linha-total-pedido">
            <span>Desconto (-)</span>
            <strong style="color: #15803d;">-<%= formatMoney(pedido.desconto) %></strong>
          </div>
        <% } %>

        <div class="linha-total-pedido linha-total-destaque">
          <span>VALOR TOTAL</span>
          <span class="valor-grande"><%= formatMoney(pedido.valor_total) %></span>
        </div>

        <div style="margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px solid #ebd9c3; font-size: 0.88rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
            <span style="color: var(--cor-texto-suave);">Sinal / Entrada:</span>
            <strong style="color: #0369a1;"><%= formatMoney(pedido.valor_sinal) %></strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
            <span style="color: var(--cor-texto-suave);">Status Pagamento:</span>
            <% if (pedido.status_pagamento === 'pago') { %>
              <span style="color: #15803d; font-weight: 700;">✅ Totalmente Pago</span>
            <% } else if (pedido.status_pagamento === 'sinal_pago') { %>
              <span style="color: #0369a1; font-weight: 700;">💵 Sinal Pago</span>
            <% } else { %>
              <span style="color: #b45309; font-weight: 700;">⏳ Pendente</span>
            <% } %>
          </div>
          <% if (pedido.forma_pagamento) { %>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--cor-texto-suave);">Forma de Pagamento:</span>
              <strong><%= pedido.forma_pagamento %></strong>
            </div>
          <% } %>
        </div>

        <div class="linha-saldo-restante">
          <span>Saldo Restante na Entrega:</span>
          <span style="font-size: 1.15rem;"><%= formatMoney(pedido.saldoRestante) %></span>
        </div>
      </div>

      <% if (pedido.observacoes) { %>
        <div class="cartao" style="font-size: 0.88rem;">
          <span style="color: var(--cor-texto-suave); font-size: 0.78rem; display: block; margin-bottom: 4px;">Observações</span>
          <p style="margin: 0; line-height: 1.45; white-space: pre-wrap;"><%= pedido.observacoes %></p>
        </div>
      <% } %>

    </div>

    <!-- Coluna Direita: Resumo WhatsApp & Status Rápido -->
    <div style="display: flex; flex-direction: column; gap: 1.15rem;">
      
      <!-- Caixa WhatsApp -->
      <div class="cartao">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <h3 style="font-size: 1rem; margin: 0; color: #166534; display: flex; align-items: center; gap: 0.4rem;">
            <span>💬</span> <span>Resumo para WhatsApp</span>
          </h3>
          <button type="button" class="btn btn-secundario btn-sm" id="btnCopiarWhats" style="border-color: #86efac; color: #166534;">
            📋 Copiar Texto
          </button>
        </div>

        <p style="font-size: 0.8rem; color: var(--cor-texto-suave); margin-bottom: 0.65rem;">
          Mensagem pronta para enviar ao cliente via WhatsApp:
        </p>

        <div class="caixa-resumo-whatsapp" id="textoWhatsPre"><%= textoWhatsApp %></div>

        <div style="margin-top: 0.85rem;">
          <% if (waLink) { %>
            <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-primario" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; background-color: #25d366; border-color: #25d366; color: #ffffff; text-decoration: none; padding: 0.65rem;">
              <span>💬</span> <span>Abrir Conversa no WhatsApp</span>
            </a>
          <% } else { %>
            <button type="button" class="btn btn-secundario" style="width: 100%; opacity: 0.7;" disabled title="Cadastre um telefone para abrir direto">
              💬 Telefone não informado para link direto
            </button>
          <% } %>
        </div>
      </div>

      <!-- Transição Rápida de Status -->
      <div class="cartao">
        <h3 style="font-size: 1rem; margin-bottom: 0.75rem; color: var(--cor-texto); display: flex; align-items: center; gap: 0.4rem;">
          <span>⚡</span> <span>Avançar Situação do Pedido</span>
        </h3>

        <form method="POST" action="/pedidos/<%= pedido.id %>/status" style="margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          <% if (pedido.status === 'orcamento') { %>
            <button type="submit" name="novo_status" value="confirmado" class="btn btn-primario btn-sm" style="background-color: #ca8a04; border-color: #ca8a04;">
              ✓ Confirmar Pedido (Sinal Recebido)
            </button>
          <% } %>

          <% if (pedido.status === 'confirmado' || pedido.status === 'orcamento') { %>
            <button type="submit" name="novo_status" value="producao" class="btn btn-primario btn-sm" style="background-color: #ea580c; border-color: #ea580c;">
              🍳 Iniciar Produção na Cozinha
            </button>
          <% } %>

          <% if (pedido.status === 'producao' || pedido.status === 'confirmado') { %>
            <button type="submit" name="novo_status" value="entregue" class="btn btn-primario btn-sm" style="background-color: #16a34a; border-color: #16a34a;">
              ✓ Marcar como Entregue ao Cliente
            </button>
          <% } %>

          <% if (pedido.status !== 'cancelado') { %>
            <button type="submit" name="novo_status" value="cancelado" class="btn btn-secundario btn-sm" style="color: #dc2626; border-color: #fca5a5;" onclick="return confirm('Deseja realmente marcar como Cancelado?');">
              ✕ Cancelar Pedido
            </button>
          <% } else { %>
            <button type="submit" name="novo_status" value="orcamento" class="btn btn-secundario btn-sm">
              ↩ Reabrir como Orçamento
            </button>
          <% } %>
        </form>
      </div>

      <!-- Exclusão de Segurança -->
      <div style="text-align: right;">
        <form method="POST" action="/pedidos/<%= pedido.id %>/excluir" style="margin: 0;" onsubmit="return confirm('ATENÇÃO: Deseja realmente excluir este pedido? Esta ação não pode ser desfeita.');">
          <button type="submit" style="background: none; border: none; color: #ef4444; font-size: 0.8rem; cursor: pointer; text-decoration: underline;">
            🗑️ Excluir este pedido definitivamente
          </button>
        </form>
      </div>

    </div>

  </div>
</div>

<script>
  // Copiar resumo para área de transferência
  const btnCopiar = document.getElementById('btnCopiarWhats');
  const textoWhats = document.getElementById('textoWhatsPre');

  if (btnCopiar && textoWhats) {
    btnCopiar.addEventListener('click', function() {
      const texto = textoWhats.innerText;
      navigator.clipboard.writeText(texto).then(() => {
        const textoOriginal = btnCopiar.textContent;
        btnCopiar.textContent = '✓ Copiado!';
        btnCopiar.style.backgroundColor = '#dcfce7';
        setTimeout(() => {
          btnCopiar.textContent = textoOriginal;
          btnCopiar.style.backgroundColor = '';
        }, 2000);
      }).catch(err => {
        alert('Não foi possível copiar automaticamente. Selecione o texto e use Ctrl+C.');
      });
    });
  }
</script>

<%- include('partials/rodape') %>
