<!-- Script do Modo Cozinha: Cronômetro, Checklist, Timers com Pop-up, Sequência IA e Web Audio API -->
<script>
  // 1. Áudio Sintetizado Nativo via Web Audio API (sem downloads externos)
  let audioCtx = null;
  function obterAudioContext() {
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
      if (AudioCtxClass) {
        audioCtx = new AudioCtxClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function tocarBeepConfeitaria() {
    try {
      const ctx = obterAudioContext();
      if (!ctx) return;

      const agora = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      // Acorde agradável em sino: 587Hz (D5) -> 880Hz (A5)
      osc.frequency.setValueAtTime(587.33, agora);
      osc.frequency.exponentialRampToValueAtTime(880.00, agora + 0.15);

      gain.gain.setValueAtTime(0.3, agora);
      gain.gain.exponentialRampToValueAtTime(0.001, agora + 0.45);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start(agora);
      osc.stop(agora + 0.45);
    } catch (_) {}
  }

  // Tocar sequência de 3 beeps de alarme
  function tocarAlarmeFimTimer() {
    tocarBeepConfeitaria();
    setTimeout(tocarBeepConfeitaria, 250);
    setTimeout(tocarBeepConfeitaria, 500);
  }

  document.getElementById('btnTestarSom').addEventListener('click', () => {
    tocarAlarmeFimTimer();
  });

  // 2. Cronômetro Geral da Cozinha
  let segundosDecorridos = 0;
  const relogioGeral = document.getElementById('relogioGeral');
  const inputTempoRealMin = document.getElementById('inputTempoRealMin');
  const textoTempoTotalConcluir = document.getElementById('textoTempoTotalConcluir');

  function formatarDoisDigitos(num) {
    return String(num).padStart(2, '0');
  }

  setInterval(() => {
    segundosDecorridos++;
    const h = Math.floor(segundosDecorridos / 3600);
    const m = Math.floor((segundosDecorridos % 3600) / 60);
    const s = segundosDecorridos % 60;
    relogioGeral.textContent = `${formatarDoisDigitos(h)}:${formatarDoisDigitos(m)}:${formatarDoisDigitos(s)}`;

    const minutosReal = Math.max(1, Math.round(segundosDecorridos / 60));
    inputTempoRealMin.value = minutosReal;
    textoTempoTotalConcluir.textContent = `${minutosReal} min (${relogioGeral.textContent})`;
  }, 1000);

  // 3. Mise en Place: Checklist de Ingredientes
  const cardsIngredientes = document.querySelectorAll('.card-ingrediente-balanca');
  const barraProgresso = document.getElementById('barraProgressoPesagem');
  const textoProgresso = document.getElementById('textoProgressoPesagem');
  const totalIngredientes = cardsIngredientes.length;

  function atualizarProgresso() {
    const pesados = document.querySelectorAll('.card-ingrediente-balanca.pesado').length;
    const pct = totalIngredientes > 0 ? Math.round((pesados / totalIngredientes) * 100) : 100;

    barraProgresso.style.width = pct + '%';
    textoProgresso.textContent = `${pesados} de ${totalIngredientes} pesados (${pct}%)`;
  }

  cardsIngredientes.forEach(card => {
    card.addEventListener('click', function() {
      this.classList.toggle('pesado');
      const btn = this.querySelector('.btn-check-pesado');
      const icone = btn.querySelector('.icone-check');
      const texto = btn.querySelector('.texto-check');

      if (this.classList.contains('pesado')) {
        icone.textContent = '✓';
        texto.textContent = 'Pesado!';
        tocarBeepConfeitaria();
      } else {
        icone.textContent = '⚖️';
        texto.textContent = 'Pesar';
      }
      atualizarProgresso();
    });
  });

  document.getElementById('btnMarcarTodos').addEventListener('click', () => {
    cardsIngredientes.forEach(card => {
      card.classList.add('pesado');
      const btn = card.querySelector('.btn-check-pesado');
      btn.querySelector('.icone-check').textContent = '✓';
      btn.querySelector('.texto-check').textContent = 'Pesado!';
    });
    tocarBeepConfeitaria();
    atualizarProgresso();
  });

  document.getElementById('btnDesmarcarTodos').addEventListener('click', () => {
    cardsIngredientes.forEach(card => {
      card.classList.remove('pesado');
      const btn = card.querySelector('.btn-check-pesado');
      btn.querySelector('.icone-check').textContent = '⚖️';
      btn.querySelector('.texto-check').textContent = 'Pesar';
    });
    atualizarProgresso();
  });

  // 4. Timers Inteligentes da Cozinha
  const containerTimers = document.getElementById('containerTimersAtivos');
  const vazioTimersMsg = document.getElementById('vazioTimersMsg');
  let idTimerSeq = 0;

  function criarTimer(nome, segundosTotais) {
    if (segundosTotais <= 0) return;
    idTimerSeq++;
    const timerId = idTimerSeq;

    if (vazioTimersMsg) vazioTimersMsg.style.display = 'none';

    let segundosRestantes = segundosTotais;
    let intervalo = null;
    let alarmeLoop = null;

    const card = document.createElement('div');
    card.className = 'card-timer-ativo';
    card.id = 'timer_card_' + timerId;

    card.innerHTML = `
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <strong style="color: var(--cor-texto); font-size: 0.95rem;">${nome}</strong>
          <span style="font-size: 0.75rem; background: #ffedd5; color: #c2410c; padding: 0.1rem 0.35rem; border-radius: 4px; font-weight: 700;">Ativo</span>
        </div>
        <div class="digitos-timer">00:00</div>
        <div class="barra-progresso-wrapper" style="height: 6px; margin-bottom: 0.5rem;">
          <div class="barra-progresso-fill barra-timer" style="background: #f97316; width: 100%;"></div>
        </div>
      </div>
      <div style="display: flex; gap: 0.4rem; justify-content: space-between; margin-top: 0.5rem;">
        <button type="button" class="btn btn-secundario btn-sm btn-pausar-timer" style="flex: 1;">Pausar</button>
        <button type="button" class="btn btn-secundario btn-sm btn-cancelar-timer" title="Remover timer">✕</button>
      </div>
    `;

    containerTimers.appendChild(card);

    const elDigitos = card.querySelector('.digitos-timer');
    const elBarra = card.querySelector('.barra-timer');
    const btnPausar = card.querySelector('.btn-pausar-timer');
    const btnCancelar = card.querySelector('.btn-cancelar-timer');

    function renderizarTimer() {
      const m = Math.floor(segundosRestantes / 60);
      const s = segundosRestantes % 60;
      elDigitos.textContent = `${formatarDoisDigitos(m)}:${formatarDoisDigitos(s)}`;

      const pct = (segundosRestantes / segundosTotais) * 100;
      elBarra.style.width = pct + '%';
    }

    renderizarTimer();

    function iniciarContagem() {
      intervalo = setInterval(() => {
        if (segundosRestantes > 0) {
          segundosRestantes--;
          renderizarTimer();
        } else {
          // Fim do timer! Disparar alarme
          clearInterval(intervalo);
          intervalo = null;
          card.classList.add('alarme-disparado');
          elDigitos.textContent = '00:00';

          // Tocar alarme em loop a cada 2.5s até desligar
          tocarAlarmeFimTimer();
          alarmeLoop = setInterval(tocarAlarmeFimTimer, 2500);

          btnPausar.textContent = '🔕 Desligar Alarme';
          btnPausar.className = 'btn btn-primario btn-sm btn-pausar-timer';
          btnPausar.style.background = '#dc2626';
          btnPausar.style.borderColor = '#b91c1c';
          btnPausar.style.fontWeight = '800';
        }
      }, 1000);
    }

    iniciarContagem();

    btnPausar.addEventListener('click', () => {
      if (alarmeLoop) {
        clearInterval(alarmeLoop);
        alarmeLoop = null;
        card.classList.remove('alarme-disparado');
        btnPausar.textContent = 'Concluído';
        btnPausar.disabled = true;
        return;
      }

      if (intervalo) {
        clearInterval(intervalo);
        intervalo = null;
        btnPausar.textContent = 'Continuar';
      } else if (segundosRestantes > 0) {
        iniciarContagem();
        btnPausar.textContent = 'Pausar';
      }
    });

    btnCancelar.addEventListener('click', () => {
      if (intervalo) clearInterval(intervalo);
      if (alarmeLoop) clearInterval(alarmeLoop);
      card.remove();

      if (containerTimers.querySelectorAll('.card-timer-ativo').length === 0) {
        if (vazioTimersMsg) vazioTimersMsg.style.display = 'block';
      }
    });
  }

  // 5. Pop-up Modal de Timers dos Eletrodomésticos
  const modalTimer = document.getElementById('modalTimerEquipamento');
  const btnFecharModal = document.getElementById('btnFecharModalTimer');
  const btnCancelarModal = document.getElementById('btnCancelarModalTimer');
  const btnIniciarModalTimer = document.getElementById('btnIniciarModalTimer');

  const modalEquipIcone = document.getElementById('modalEquipIcone');
  const modalEquipTitulo = document.getElementById('modalEquipTitulo');
  const modalEquipSubtitulo = document.getElementById('modalEquipSubtitulo');
  const modalPresetsContainer = document.getElementById('modalEquipPresetsContainer');
  const modalInputNome = document.getElementById('modalInputNome');
  const modalInputMin = document.getElementById('modalInputMin');
  const modalInputSeg = document.getElementById('modalInputSeg');

  function fecharModalTimer() {
    modalTimer.style.display = 'none';
  }

  btnFecharModal.addEventListener('click', fecharModalTimer);
  btnCancelarModal.addEventListener('click', fecharModalTimer);
  modalTimer.addEventListener('click', (e) => {
    if (e.target === modalTimer) fecharModalTimer();
  });

  document.querySelectorAll('.card-equipamento-timer').forEach(card => {
    card.addEventListener('click', () => {
      const equip = card.getAttribute('data-equip');
      const icone = card.getAttribute('data-icone');
      const nome = card.getAttribute('data-nome');
      const subtitulo = card.getAttribute('data-subtitulo');
      const presetsJson = card.getAttribute('data-presets') || '[]';

      modalEquipIcone.textContent = icone;
      modalEquipTitulo.textContent = `${icone} Timer: ${nome}`;
      modalEquipSubtitulo.textContent = subtitulo;
      modalInputNome.value = `${nome} (${produtoNome})`;

      // Renderizar botões de preset
      let presets = [];
      try {
        presets = JSON.parse(presetsJson);
      } catch (_) {}

      modalPresetsContainer.innerHTML = '';
      if (presets.length > 0) {
        modalInputMin.value = presets[0].min;
        modalInputSeg.value = 0;

        presets.forEach(p => {
          const btnChip = document.createElement('button');
          btnChip.type = 'button';
          btnChip.className = 'btn-preset-chip';
          btnChip.innerHTML = `<div>${p.rotulo}</div><div style="font-size: 0.68rem; font-weight: normal; opacity: 0.85;">${p.desc}</div>`;
          btnChip.addEventListener('click', () => {
            modalInputMin.value = p.min;
            modalInputSeg.value = 0;
            modalInputNome.value = `${nome} - ${p.desc}`;
          });
          modalPresetsContainer.appendChild(btnChip);
        });
      }

      modalTimer.style.display = 'flex';
    });
  });

  btnIniciarModalTimer.addEventListener('click', () => {
    const nome = (modalInputNome.value || 'Timer').trim();
    const min = parseInt(modalInputMin.value, 10) || 0;
    const seg = parseInt(modalInputSeg.value, 10) || 0;
    const totalSeg = (min * 60) + seg;

    if (totalSeg > 0) {
      criarTimer(nome, totalSeg);
      fecharModalTimer();
    }
  });

  // 6. Sequência Inteligente de Misturas (IA & Heurística Culinária)
  const produtoId = <%= produto.id %>;
  const produtoNome = "<%= produto.nome.replace(/"/g, '\\"') %>";
  const fatorEscala = <%= fator %>;

  const btnGerarPassosIA = document.getElementById('btnGerarPassosIA');
  const btnGerarPassosIABig = document.getElementById('btnGerarPassosIABig');
  const btnSalvarModoPreparoReceita = document.getElementById('btnSalvarModoPreparoReceita');
  const loaderIaPreparo = document.getElementById('loaderIaPreparo');
  const containerPassosPreparo = document.getElementById('containerPassosPreparo');
  const iconeBtnIa = document.getElementById('iconeBtnIa');
  const textoBtnIa = document.getElementById('textoBtnIa');

  let ultimaSequenciaGerada = null;

  function vincularEventosPassos(contexto) {
    // Botões de conclusão dos passos
    contexto.querySelectorAll('.btn-concluir-passo').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const cardPasso = this.closest('.card-passo-mistura');
        cardPasso.classList.toggle('passo-concluido');
        if (cardPasso.classList.contains('passo-concluido')) {
          this.textContent = 'Refazer';
          tocarBeepConfeitaria();
        } else {
          this.textContent = '✓ Concluir';
        }
      });
    });

    // Botões de disparar timer direto da etapa
    contexto.querySelectorAll('.btn-disparar-timer-passo').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const nomeTimer = this.getAttribute('data-nome') || 'Timer do Passo';
        const minutos = parseInt(this.getAttribute('data-minutos'), 10) || 10;
        criarTimer(nomeTimer, minutos * 60);
      });
    });
  }

  // Vincular eventos aos passos já renderizados do servidor
  vincularEventosPassos(document);

  async function dispararGeracaoIA() {
    if (loaderIaPreparo) loaderIaPreparo.style.display = 'block';
    if (btnGerarPassosIA) {
      btnGerarPassosIA.disabled = true;
      iconeBtnIa.textContent = '⏳';
      textoBtnIa.textContent = 'Calculando...';
    }

    try {
      const resp = await fetch(`/producao/produto/${produtoId}/gerar-passos-ia`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fator: fatorEscala })
      });

      const dados = await resp.json();
      if (!dados.sucesso || !dados.sequencia) {
        throw new Error(dados.erro || 'Falha ao processar receita.');
      }

      ultimaSequenciaGerada = dados.sequencia;
      renderizarPassosNaTela(dados.sequencia);

      // Exibir botão de salvar na receita
      if (btnSalvarModoPreparoReceita) {
        btnSalvarModoPreparoReceita.style.display = 'inline-flex';
      }

      tocarBeepConfeitaria();
    } catch (err) {
      alert('Não foi possível gerar a sequência no momento: ' + err.message);
    } finally {
      if (loaderIaPreparo) loaderIaPreparo.style.display = 'none';
      if (btnGerarPassosIA) {
        btnGerarPassosIA.disabled = false;
        iconeBtnIa.textContent = '✨';
        textoBtnIa.textContent = 'Regerar Sequência';
      }
    }
  }

  function renderizarPassosNaTela(seq) {
    const passos = seq.passos || [];
    if (passos.length === 0) return;

    let html = `
      <div style="margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <span style="font-size: 0.85rem; font-weight: 800; color: #6b21a8; text-transform: uppercase;">
          🥣 ${seq.tipo_receita || 'Sequência Sugerida pelo Chef'}
        </span>
        <span style="font-size: 0.78rem; background: #faf5ff; border: 1px solid #e9d5ff; color: #7e22ce; padding: 0.2rem 0.5rem; border-radius: 999px; font-weight: 600;">
          ${seq.fonte === 'gemini_ia' ? '✨ Gerado por IA Confeiteira' : '🍳 Confeitaria Clássica'}
        </span>
      </div>
    `;

    passos.forEach((p, idx) => {
      const ordem = p.ordem || (idx + 1);
      html += `
        <div class="card-passo-mistura" id="passo_gerado_${idx}">
          <div class="badge-numero-passo">${ordem}</div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.5rem; flex-wrap: wrap;">
              <strong style="font-size: 0.98rem; color: var(--cor-texto);">${p.titulo}</strong>
              
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                ${p.tempo_timer_min ? `
                  <button type="button" class="btn btn-secundario btn-sm btn-disparar-timer-passo" 
                          data-nome="${p.titulo}" 
                          data-minutos="${p.tempo_timer_min}"
                          style="font-size: 0.75rem; padding: 0.2rem 0.5rem; background: #fff7ed; border-color: #fdba74; color: #c2410c; font-weight: 700;">
                    ⏱️ Timer ${p.tempo_timer_min} min
                  </button>
                ` : ''}
                <button type="button" class="btn btn-secundario btn-sm btn-concluir-passo" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;">
                  ✓ Concluir
                </button>
              </div>
            </div>

            <div class="passo-instrucao-texto" style="font-size: 0.88rem; color: var(--cor-texto); line-height: 1.45; margin-top: 0.35rem;">
              ${p.instrucao}
            </div>

            ${p.ponto_visual ? `
              <div class="etapa-ponto-visual">
                👁️ <strong>Ponto Visual:</strong> ${p.ponto_visual}
              </div>
            ` : ''}

            ${p.dica_chef ? `
              <div class="etapa-dica-chef">
                💡 <strong>Dica do Chef:</strong> ${p.dica_chef}
              </div>
            ` : ''}
          </div>
        </div>
      `;
    });

    containerPassosPreparo.innerHTML = html;
    vincularEventosPassos(containerPassosPreparo);
  }

  if (btnGerarPassosIA) {
    btnGerarPassosIA.addEventListener('click', dispararGeracaoIA);
  }
  if (btnGerarPassosIABig) {
    btnGerarPassosIABig.addEventListener('click', dispararGeracaoIA);
  }

  if (btnSalvarModoPreparoReceita) {
    btnSalvarModoPreparoReceita.addEventListener('click', async () => {
      if (!ultimaSequenciaGerada) return;

      btnSalvarModoPreparoReceita.disabled = true;
      btnSalvarModoPreparoReceita.textContent = 'Salvando...';

      try {
        const resp = await fetch(`/producao/produto/${produtoId}/salvar-modo-preparo`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ modo_preparo: ultimaSequenciaGerada })
        });
        const d = await resp.json();
        if (d.sucesso) {
          btnSalvarModoPreparoReceita.textContent = '✓ Salvo na Receita!';
          btnSalvarModoPreparoReceita.style.background = '#dcfce7';
          btnSalvarModoPreparoReceita.style.color = '#15803d';
          setTimeout(() => {
            btnSalvarModoPreparoReceita.textContent = '💾 Salvar na Receita';
            btnSalvarModoPreparoReceita.disabled = false;
          }, 3000);
        } else {
          alert('Erro ao salvar.');
          btnSalvarModoPreparoReceita.disabled = false;
          btnSalvarModoPreparoReceita.textContent = '💾 Salvar na Receita';
        }
      } catch (e) {
        alert('Erro de conexão ao salvar.');
        btnSalvarModoPreparoReceita.disabled = false;
        btnSalvarModoPreparoReceita.textContent = '💾 Salvar na Receita';
      }
    });
  }
</script>

