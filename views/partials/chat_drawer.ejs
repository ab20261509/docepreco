<!-- Botão Flutuante no Canto Superior Direito & Painel Lateral do Assistente IA -->
<style>
  .btn-flutuante-assistente {
    position: fixed;
    top: 12px;
    right: 16px;
    z-index: 9998;
    background: linear-gradient(135deg, #7c3aed, #9333ea);
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4);
    border-radius: 999px;
    padding: 0.38rem 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 800;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
  }
  .btn-flutuante-assistente:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 18px rgba(124, 58, 237, 0.5);
    background: linear-gradient(135deg, #6d28d9, #7e22ce);
  }
  .pulso-online-ia {
    width: 8px;
    height: 8px;
    background: #4ade80;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.4);
    animation: pulsoVerde 2s infinite;
  }
  @keyframes pulsoVerde {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(74, 222, 128, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  @media (min-width: 601px) {
    .usuario-info {
      margin-right: 145px !important;
    }
  }
  @media (max-width: 600px) {
    .btn-flutuante-assistente {
      top: 10px;
      right: 10px;
      padding: 0.35rem 0.55rem;
    }
    .btn-flutuante-assistente .texto-btn-ia {
      display: none;
    }
    .usuario-info {
      margin-right: 48px !important;
    }
  }

  /* Overlay do Drawer */
  .drawer-assistente-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(3px);
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
  }
  .drawer-assistente-overlay.aberto {
    opacity: 1;
    visibility: visible;
  }

  /* Painel Deslizante Lateral (Drawer) */
  .drawer-assistente-painel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 440px;
    max-width: 95vw;
    background: #ffffff;
    box-shadow: -6px 0 25px rgba(0,0,0,0.15);
    z-index: 10001;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .drawer-assistente-overlay.aberto .drawer-assistente-painel {
    transform: translateX(0);
  }

  /* Cabeçalho do Drawer */
  .drawer-header {
    background: #1e293b;
    color: #ffffff;
    padding: 1rem 1.15rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
    flex-shrink: 0;
  }
  .drawer-fechar-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 1.35rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }
  .drawer-fechar-btn:hover {
    background: #334155;
    color: #ffffff;
  }

  /* Área de Mensagens */
  .drawer-mensagens {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .drawer-mensagens::-webkit-scrollbar {
    width: 5px;
  }
  .drawer-mensagens::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }

  /* Balões de Mensagem no Drawer */
  .drawer-msg {
    display: flex;
    gap: 0.5rem;
    max-width: 88%;
    animation: fadeInMsg 0.15s ease-out;
  }
  .drawer-msg.usuario {
    align-self: flex-end;
    flex-direction: row-reverse;
  }
  .drawer-msg.assistente {
    align-self: flex-start;
  }
  .drawer-msg-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .drawer-msg.usuario .drawer-msg-avatar {
    background: #e0f2fe;
    color: #0369a1;
  }
  .drawer-msg.assistente .drawer-msg-avatar {
    background: #ede9fe;
    color: #6d28d9;
  }
  .drawer-msg-balao {
    padding: 0.75rem 0.95rem;
    border-radius: 12px;
    font-size: 0.86rem;
    line-height: 1.45;
    word-break: break-word;
  }
  .drawer-msg.usuario .drawer-msg-balao {
    background: #7c3aed;
    color: #ffffff;
    border-bottom-right-radius: 3px;
  }
  .drawer-msg.assistente .drawer-msg-balao {
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    border-bottom-left-radius: 3px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
  }
  .drawer-msg-balao a {
    color: #0284c7;
    font-weight: 700;
    text-decoration: underline;
  }
  .drawer-msg.usuario .drawer-msg-balao a {
    color: #fef08a;
  }
  .drawer-msg-hora {
    font-size: 0.65rem;
    margin-top: 0.25rem;
    opacity: 0.75;
    text-align: right;
  }

  /* Sugestões Rápidas */
  .drawer-sugestoes {
    padding: 0.55rem 0.85rem;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .drawer-sugestoes::-webkit-scrollbar {
    height: 3px;
  }
  .drawer-sugestoes::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }
  .drawer-chip {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }
  .drawer-chip:hover {
    background: #7c3aed;
    border-color: #6d28d9;
    color: #ffffff;
  }

  /* Barra de Envio */
  .drawer-input-bar {
    padding: 0.75rem 0.85rem;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-shrink: 0;
  }
  .drawer-input {
    flex: 1;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    font-size: 0.86rem;
    outline: none;
  }
  .drawer-input:focus {
    border-color: #7c3aed;
    background: #ffffff;
  }
  .drawer-btn-enviar {
    background: #7c3aed;
    border: 1px solid #6d28d9;
    color: #ffffff;
    padding: 0.65rem 0.95rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.86rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .drawer-btn-enviar:hover:not(:disabled) {
    background: #6d28d9;
  }
  .drawer-btn-enviar:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .drawer-digitando {
    display: none;
    align-self: flex-start;
    padding: 0.5rem 0.85rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 0.78rem;
    color: #6b21a8;
    align-items: center;
    gap: 0.4rem;
  }
</style>

<!-- Botão Flutuante (Canto Superior Direito) -->
<button type="button" id="btnFlutuanteAssistente" class="btn-flutuante-assistente" title="Abrir Assistente Virtual (Dúvidas sobre o sistema e tarefas)">
  <span class="pulso-online-ia"></span>
  <span style="font-size: 1rem;">💬</span>
  <span class="texto-btn-ia">Assistente IA</span>
</button>

<!-- Painel Lateral Deslizante (Drawer) -->
<div id="drawerAssistenteOverlay" class="drawer-assistente-overlay">
  <div class="drawer-assistente-painel">
    
    <!-- Cabeçalho do Drawer -->
    <div class="drawer-header">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.35rem;">🧁</span>
        <div>
          <strong style="font-size: 0.98rem; display: block; line-height: 1.2;">DoceIA • Assistente</strong>
          <span style="font-size: 0.7rem; color: #94a3b8;">Sistema & Tarefas da Confeitaria</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <button type="button" id="drawerBtnLimpar" title="Limpar conversa" style="background: transparent; border: none; color: #94a3b8; font-size: 0.8rem; cursor: pointer;">
          🗑️
        </button>
        <button type="button" id="drawerBtnFechar" class="drawer-fechar-btn" title="Fechar painel">
          ✕
        </button>
      </div>
    </div>

    <!-- Área de Mensagens -->
    <div class="drawer-mensagens" id="drawerMensagensContainer">
      <div class="drawer-msg assistente">
        <div class="drawer-msg-avatar">🧁</div>
        <div class="drawer-msg-balao">
          Olá! 👋 Sou a assistente virtual do <strong>DocePreço</strong>.
          <div style="margin-top: 0.25rem; font-size: 0.8rem; color: #475569;">
            Pergunte como usar o sistema ou consulte tarefas, encomendas e estoque de hoje!
          </div>
        </div>
      </div>

      <div class="drawer-digitando" id="drawerIndicadorDigitando">
        <span>✨</span>
        <span>Consultando informações...</span>
      </div>
    </div>

    <!-- Sugestões Rápidas com 1 Clique -->
    <div class="drawer-sugestoes">
      <button type="button" class="drawer-chip" data-pergunta="Quais encomendas temos para hoje?">
        📅 Encomendas de hoje
      </button>
      <button type="button" class="drawer-chip" data-pergunta="O que está em preparo na cozinha agora?">
        🍳 Produção na cozinha
      </button>
      <button type="button" class="drawer-chip" data-pergunta="Quais ingredientes estão com estoque baixo?">
        ⚠️ Estoque baixo
      </button>
      <button type="button" class="drawer-chip" data-pergunta="Temos lotes com validade próxima?">
        ⏰ Validade de insumos
      </button>
      <button type="button" class="drawer-chip" data-pergunta="Como funciona o cálculo do custo por hora?">
        🏢 Custo por hora
      </button>
      <button type="button" class="drawer-chip" data-pergunta="Como calcular o preço sugerido das receitas?">
        🧁 Preço sugerido
      </button>
    </div>

    <!-- Barra de Entrada e Envio -->
    <form id="drawerFormChat" class="drawer-input-bar">
      <input type="text" id="drawerInputMsg" class="drawer-input" placeholder="Tire sua dúvida sobre o sistema..." autocomplete="off">
      <button type="submit" id="drawerBtnEnviar" class="drawer-btn-enviar">
        ➤
      </button>
    </form>

  </div>
</div>

<script>
  (function() {
    const btnFlutuante = document.getElementById('btnFlutuanteAssistente');
    const overlay = document.getElementById('drawerAssistenteOverlay');
    const btnFechar = document.getElementById('drawerBtnFechar');
    const containerMsgs = document.getElementById('drawerMensagensContainer');
    const formChat = document.getElementById('drawerFormChat');
    const inputMsg = document.getElementById('drawerInputMsg');
    const btnEnviar = document.getElementById('drawerBtnEnviar');
    const indicador = document.getElementById('drawerIndicadorDigitando');
    const btnLimpar = document.getElementById('drawerBtnLimpar');

    let historicoCarregado = false;

    function rolarFim() {
      containerMsgs.scrollTop = containerMsgs.scrollHeight;
    }

    function formatarTexto(texto) {
      if (!texto) return '';
      return texto
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br>')
        .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>');
    }

    function adicionarMensagemDrawer(papel, conteudo, hora) {
      const div = document.createElement('div');
      div.className = `drawer-msg ${papel}`;
      div.innerHTML = `
        <div class="drawer-msg-avatar">${papel === 'usuario' ? '👤' : '🧁'}</div>
        <div class="drawer-msg-balao">
          <div>${formatarTexto(conteudo)}</div>
          <div class="drawer-msg-hora">${hora || ''}</div>
        </div>
      `;
      containerMsgs.insertBefore(div, indicador);
      rolarFim();
    }

    async function carregarHistoricoDoBanco() {
      if (historicoCarregado) return;
      try {
        const resp = await fetch('/assistente/historico');
        const dados = await resp.json();
        if (dados.sucesso && Array.isArray(dados.mensagens)) {
          dados.mensagens.forEach(m => {
            const hora = m.criado_em ? m.criado_em.substring(11, 16) : '';
            adicionarMensagemDrawer(m.papel, m.conteudo, hora);
          });
          historicoCarregado = true;
          rolarFim();
        }
      } catch (_) {}
    }

    function abrirDrawer() {
      overlay.classList.add('aberto');
      carregarHistoricoDoBanco();
      setTimeout(() => inputMsg.focus(), 300);
    }

    function fecharDrawer() {
      overlay.classList.remove('aberto');
    }

    btnFlutuante.addEventListener('click', abrirDrawer);
    btnFechar.addEventListener('click', fecharDrawer);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) fecharDrawer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('aberto')) {
        fecharDrawer();
      }
    });

    formChat.addEventListener('submit', async (e) => {
      e.preventDefault();
      const texto = inputMsg.value.trim();
      if (!texto) return;

      inputMsg.value = '';
      btnEnviar.disabled = true;

      const agora = new Date();
      const horaAtual = `${String(agora.getHours()).padStart(2, '0')}:${String(agora.getMinutes()).padStart(2, '0')}`;
      adicionarMensagemDrawer('usuario', texto, horaAtual);

      indicador.style.display = 'flex';
      rolarFim();

      try {
        const resp = await fetch('/assistente/mensagem', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mensagem: texto })
        });
        const dados = await resp.json();

        if (dados.sucesso && dados.resposta) {
          adicionarMensagemDrawer('assistente', dados.resposta, dados.hora);
        } else {
          adicionarMensagemDrawer('assistente', 'Desculpe, ocorreu um erro ao gerar a resposta. Tente novamente.', horaAtual);
        }
      } catch (_) {
        adicionarMensagemDrawer('assistente', 'Erro de conexão com o servidor.', horaAtual);
      } finally {
        indicador.style.display = 'none';
        btnEnviar.disabled = false;
        inputMsg.focus();
        rolarFim();
      }
    });

    // Chips com perguntas com 1 clique
    document.querySelectorAll('.drawer-chip').forEach(btn => {
      btn.addEventListener('click', function() {
        const p = this.getAttribute('data-pergunta');
        inputMsg.value = p;
        formChat.dispatchEvent(new Event('submit'));
      });
    });

    // Limpar conversa
    btnLimpar.addEventListener('click', async () => {
      if (!confirm('Deseja limpar as mensagens gravadas deste assistente?')) return;
      try {
        await fetch('/assistente/historico', { method: 'DELETE' });
        // Manter apenas a mensagem de boas vindas
        const msgs = containerMsgs.querySelectorAll('.drawer-msg');
        msgs.forEach((m, idx) => {
          if (idx > 0) m.remove();
        });
        historicoCarregado = true;
      } catch (_) {
        alert('Erro ao limpar histórico.');
      }
    });
  })();
</script>
