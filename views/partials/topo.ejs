<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof nomeSistema !== 'undefined' ? nomeSistema : 'DocePreço' %> 🧁</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <header class="topo">
    <div class="topo-conteudo">
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/" class="logo" title="Ir para o Início">
          <span class="icone">🧁</span>
          <span><%= typeof nomeSistema !== 'undefined' ? nomeSistema : 'DocePreço' %></span>
        </a>

        <% if (usuario) { %>
          <a href="/" class="btn-topo-inicio" title="Menu Principal">
            <span style="font-size: 1rem;">🏠</span>
            <span>Início</span>
          </a>

          <% if (typeof isMaster !== 'undefined' && isMaster) { %>
            <a href="/master" class="btn-topo-inicio" title="Painel de Controle Master" style="background: #fef3c7; color: #92400e; border-color: #fde68a; font-weight: 700;">
              <span>🛡️</span>
              <span>Painel Master</span>
            </a>
          <% } %>
        <% } %>
      </div>

      <% if (usuario) { %>
        <div class="usuario-info">
          <span>
            Olá, <strong class="usuario-nome"><%= usuario.nome %></strong>
            <% if (usuario.perfil === 'master') { %>
              <span style="background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.68rem; font-weight: 800; padding: 0.1rem 0.4rem; border-radius: 999px; margin-left: 0.2rem;">Master</span>
            <% } %>
          </span>
          <form method="POST" action="/logout" style="margin: 0;">
            <button type="submit" class="btn btn-secundario btn-sm">Sair</button>
          </form>
        </div>
      <% } else { %>
        <nav class="menu">
          <a href="/login">Entrar</a>
          <a href="/cadastro" class="btn btn-primario btn-sm" style="color: #fff;">Criar Conta</a>
        </nav>
      <% } %>
    </div>
  </header>

  <% if (typeof avisoGeralBanner !== 'undefined' && avisoGeralBanner) { %>
    <div style="background: #fffbeb; border-bottom: 1px solid #fde68a; color: #92400e; padding: 0.65rem 1.25rem; font-size: 0.85rem; font-weight: 600; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
      <span>📢</span>
      <span><%= avisoGeralBanner %></span>
    </div>
  <% } %>

  <main class="container">
